      }
    },
    {
      "@id": "edm:replacedBy",
      "@type": "owl:ObjectProperty",
      "schema:domainIncludes": {
        "@id": "edm:Thing"
      },
      "schema:rangeIncludes": {
        "@id": "edm:Thing"
      },
      "rdfs:comment": "Connects two entities of the same type where the change in characteristics that is other than a name change affects the identity of the entity. Entity A ceases to exist because some of its characteristics have changed and is replaced by entity B which then comes into existence. Examples are journals where the journal becomes electronic only or open access only and it becomes a new journal with a new identifier.",
      "rdfs:label": "replaced by",
      "rdfs:subPropertyOf": "edm:succeededBy",
      "owl:equivalentProperty": "http://id.loc.gov/ontologies/bibframe/replacedBy",
      "owl:inverseOf": {
        "@id": "edm:replacementOf"
      }
    },
    {
      "@id": "edm:replacementOf",
      "@type": "owl:ObjectProperty",
      "schema:domainIncludes": {
        "@id": "edm:Thing"
      },
      "schema:rangeIncludes": {
        "@id": "edm:Thing"
      },
      "rdfs:comment": "Connects two entities of the same type where the change in characteristics that is other than a name change affects the identity of the entity. Entity A comes into existence replacing entity B, which ceases to exist because some of its characteristics have changed.  Examples are journals where the journal becomes electronic only or open access only and it becomes a new journal with a new identifier.",
      "rdfs:label": "replacement of",
      "rdfs:subPropertyOf": "edm:precededBy",
      "owl:equivalentProperty": "http://id.loc.gov/ontologies/bibframe/replacementOf",
      "owl:inverseOf": {
        "@id": "edm:replacedBy"
      }
    },
