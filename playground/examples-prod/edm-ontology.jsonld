      "rdfs:label": "is element",
      "rdfs:isDefinedBy": {
        "@id": "https://elsevier.atlassian.net/wiki/spaces/arch/pages/87664312340/Content+Profile+and+Linked+Document+Standard"
      }
    },
    {
      "@id": "edm:isViewOf",
      "@type": "owl:ObjectProperty",
      "schema:domainIncludes": [
        {
          "@id": "edm:Dataset"
        },
        {
          "@id": "edm:File"
        },
        {
          "@id": "edm:MediaObject"
        }
      ],
      "schema:rangeIncludes": {
        "@id": "edm:Thing"
      },
      "rdfs:comment": "The dataset or media object is a (physical) representation, or view of the focus entity. For instance, the article with id S0092867420306103 has a version captured as a set of multiple media objects, described as a dataset.",
      "rdfs:label": "is view of"
    },
    {
      "@id": "edm:isbn",
      "@type": "owl:DatatypeProperty",
