        }
      ],
      "rdfs:comment": "The Degree or Honors is held by a person, a group or organization.",
      "rdfs:label": "held by",
      "owl:inverseOf": {
        "@id": "edm:holds"
      }
    },
    {
      "@id": "edm:holds",
