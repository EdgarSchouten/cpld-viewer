          "@id": "edm:Dataset"
        },
        {
          "@id": "edm:File"
        },
        {
          "@id": "edm:MediaObject"
        }
      ],
      "rdfs:comment": "Indicates whether the Dataset, File or MediaObject contains personal health information (PHI). Use true when it does contain PHI and false when it does not. Remember to check guidelines and policies to understand what kind of data qualifies as personal health information.",
      "rdfs:label": "personal health data",
      "rdfs:range": {
        "@id": "xsd:boolean"
      }
    },
