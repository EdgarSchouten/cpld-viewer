    {
      "@id": "edm:identifier",
      "@type": "owl:DatatypeProperty",
      "schema:domainIncludes": {
        "@id": "edm:Thing"
      },
      "rdfs:comment": "The identifier contains any kind of identifier used to represent the specific entity where the `@type` is a registered identifier type, and `@value` is the identifier value, such that their combination is unique. In order to conform with Elsevier's Architecture Identifier Standard identifier type MUST be registered in the Identifier Type Registry. See referenced document (seeAlso). Note that the identifier must be used for identifiers that represent the entity and not identifiers that represent its containers or parts.",
      "rdfs:label": "identifier",
      "rdfs:range": {
        "@id": "rdfs:Literal"
      },
      "rdfs:seeAlso": "https://elsevier.atlassian.net/wiki/spaces/arch/pages/87719282210/Identifier+Standard#tab-0bd075e9-b182-4366-bcf9-61c279018724"
    },
    {
      "@id": "edm:imprint",
      "@type": "owl:DatatypeProperty",
      "schema:domainIncludes": {
        "@id": "edm:Work"
      },
      "rdfs:comment": "The publisher imprint of the Work.",
      "rdfs:label": "imprint",
      "rdfs:range": {
        "@id": "rdfs:Literal"
      }
    },
    {
      "@id": "edm:index",
      "@type": "owl:DatatypeProperty",
      "schema:rangeIncludes": [
        {
          "@id": "xsd:int"
        },
        {
          "@id": "xsd:integer"
        }
      ],
      "rdfs:comment": "A numerical index used to indicate the position of an entity in a list or enumeration of similar entities, where the order is important. For instance, the position of an author in the byline of an article. The convention is to start numbering at '1'.",
      "rdfs:label": "index"
    },
    {
      "@id": "edm:inLanguage",
      "@type": "owl:DatatypeProperty",
      "schema:domainIncludes": {
        "@id": "edm:Work"
      },
      "rdfs:comment": "The language in which the Work is written. This property replaces edm:language from version 1.3.1 of the EDM.",
      "rdfs:label": "in language",
      "rdfs:range": {
        "@id": "xsd:language"
      }
    },
    {
      "@id": "edm:inLanguageScript",
      "@type": "owl:DatatypeProperty",
      "schema:domainIncludes": [
        {
          "@id": "edm:Work"
        },
        {
          "@id": "edm:Name"
        }
      ],
      "rdfs:comment": "The language, script and regional variation in which a text based entity such as a Work or a Name is written. This property is distinct from `edm:inLanguage`. The expected values are subtags as defined by the IETF BCP-47 standard.",
      "rdfs:label": "in language script",
      "rdfs:range": {
        "@id": "rdfs:Literal"
      },
      "rdfs:seeAlso": {
        "@id": "https://www.iana.org/assignments/language-subtag-registry/language-subtag-registry"
      } 
    },
    {
      "@id": "edm:inchi",
      "@type": "owl:DatatypeProperty",
      "owl:deprecated": {
        "@value": true,
        "@type": "xsd:boolean"
      },
      "schema:domainIncludes": {
        "@id": "edm:Substance"
      },
      "rdfs:comment": "This attribute is deprecated. Please use edm:identifier in combination with the correct identifier type from the Identifier Type Registry. The International Chemical Identifier (InChI) is a textual identifier for chemical Substances, designed to provide a standard way to encode molecular information and to facilitate the search for such information in databases and on the web.",
      "rdfs:label": "InChI",
      "rdfs:subPropertyOf": {
        "@id": "edm:identifier"
      }
    },
    {
      "@id": "edm:inchiKey",
      "@type": "owl:DatatypeProperty",
      "owl:deprecated": {
        "@value": true,
        "@type": "xsd:boolean"
      },
      "schema:domainIncludes": {
        "@id": "edm:Substance"
      },
      "rdfs:comment": "This attribute is deprecated. Please use edm:identifier in combination with the correct identifier type from the Identifier Type Registry. The hashed version of the International Chemical Identifier (InChI) used for Substances.",
      "rdfs:label": "InChI key",
      "rdfs:subPropertyOf": {
        "@id": "edm:identifier"
      }
    },
