        {
          "@id": "edm:Service"
        },
        {
          "@id": "edm:Substance"
        },
        {
          "@id": "edm:Thing"
        },
        {
          "@id": "edm:Work"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "edm:Drug"
