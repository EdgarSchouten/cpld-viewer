      "@id": "edm:references",
      "@type": "owl:ObjectProperty",
      "schema:domainIncludes": {
        "@id": "edm:Work"
      },
      "schema:rangeIncludes": {
        "@id": "edm:Work"
      },
      "rdfs:comment": "The Work references another Work.",
