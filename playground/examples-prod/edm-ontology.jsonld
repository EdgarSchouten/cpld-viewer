          "@id": "edm:Dataset"
        },
        {
          "@id": "edm:File"
        },
        {
          "@id": "edm:MediaObject"
        }
      ],
      "rdfs:comment": "Indicates whether the Dataset, File or MediaObject contains personally identifiable data (PII). Use true when it does contain PII and false when it does not. Remember to check guidelines and policies to understand what kind of data qualifies as personally identifiable data.",
      "rdfs:label": "personal data",
      "rdfs:range": {
        "@id": "xsd:boolean"
      }
    },
    {
      "@id": "edm:personalHealthData",
      "@type": "owl:DatatypeProperty",
