      "rdfs:label": "has instructor",
      "owl:inverseOf": {
        "@id": "edm:instructorOf"
      }
    },
    {
      "@id": "edm:hasLearner",
      "@type": "owl:ObjectProperty",
      "schema:domainIncludes": {
        "@id": "edm:Organization"
      },
      "schema:rangeIncludes": {
        "@id": "edm:Person"
      },
      "rdfs:comment": "The relation from a Organization to the Person where education was received. The Organization has learner a Person, in other words provides education to a Person.",
      "rdfs:label": "has learner",
      "owl:inverseOf": {
        "@id": "edm:educatedAt"
      }
    },
    {
      "@id": "edm:hasLocation",
      "@type": "owl:ObjectProperty",
      "schema:domainIncludes": {
        "@id": "edm:Thing"
      },
      "schema:rangeIncludes": {
        "@id": "edm:Location"
      },
      "rdfs:comment": "The entity has a geographic location associated with it.The inverse relation is intentionally omitted as instances of Location are not treated as entities across Elsevier (no indexing or deduplication).",
      "rdfs:label": "has location"
    },
    {
      "@id": "edm:hasMember",
      "@type": "owl:ObjectProperty",
      "schema:domainIncludes": [
        {
          "@id": "edm:Group"
        },
        {
          "@id": "edm:Organization"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "edm:Organization"
        },
        {
          "@id": "edm:Person"
        }
      ],
      "rdfs:comment": "The Group or Organization has Person or Organization as Member.",
      "rdfs:label": "has member",
      "owl:inverseOf": {
        "@id": "edm:memberOf"
      }
    },
    {
      "@id": "edm:hasMentor",
      "@type": "owl:ObjectProperty",
      "schema:domainIncludes": [
        {
          "@id": "edm:Person"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "edm:Person"
        }
      ],
