    {
      "@id": "edm:roleOf",
      "@type": "owl:ObjectProperty",
      "schema:domainIncludes": {
        "@id": "edm:Role"
      },
      "schema:rangeIncludes": {
        "@id": "edm:Actor"
      },
      "rdfs:comment": "The Role associated with the Actor. This relation used with `edm:contextOf` allows the capturing of more information about the Actor's Role in the context of something else. There is an explicit directionality: Thing contextOf Role, Role roleOf Actor. For example: A Book contextOf Author, Author roleOf Person. In this case information about the authorship can be associated with the Author entity instance, whereas `edm:authorOf` captures the direct relationship between a Book and a Person.",
      "rdfs:label": "role of",
      "owl:inverseOf": {
        "@id": "edm:hasRole"
      }
    },
    {
      "@id": "edm:schemaOf",
      "@type": "owl:ObjectProperty",
      "schema:domainIncludes": {
        "@id": "edm:Schema"
      },
      "schema:rangeIncludes": [
        {
          "@id": "edm:Dataset"
        },
        {
          "@id": "edm:Vocabulary"
        }
      ],
      "rdfs:comment": "The Schema is associated with the work most notably for Vocabularies or Datasets.",
      "rdfs:label": "schema of",
      "owl:inverseOf": {
        "@id": "edm:hasSchema"
      }
    },
    {
      "@id": "edm:separatedFrom",
      "@type": "owl:ObjectProperty",
      "schema:domainIncludes": {
        "@id": "edm:Thing"
      },
      "schema:rangeIncludes": {
        "@id": "edm:Thing"
      },
      "rdfs:comment": "Connects entities where entity A is separated from by entity B and entity A did not exist prior to the separation but entity B continues to exist after the separation.",
