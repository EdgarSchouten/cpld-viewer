      },
      "rdfs:comment": "The Issue number or Issue name associated with an Article. Only to be used as an attribute of the Article and not as a property of the Issue itself. It is preferred to explicitly define an Issue entity with an `edm:label`.",
      "rdfs:label": "issue label",
      "rdfs:subPropertyOf": {
        "@id": "edm:label"
      }
    },
    {
      "@id": "edm:label",
      "@type": "owl:DatatypeProperty",
      "schema:domainIncludes": {
        "@id": "edm:Thing"
      },
      "rdfs:comment": "The label associated with the entity.",
      "rdfs:label": "label",
      "rdfs:range": {
        "@id": "rdfs:Literal"
      }
    },
    {
      "@id": "edm:labHours",
      "@type": "owl:DatatypeProperty",
      "schema:domainIncludes": [
        {
          "@id": "edm:Course"
        },
        {
          "@id": "edm:CourseInstance"
        }
      ],
      "rdfs:comment": "The number of hours assigned to hands-on, laboratory-based instructional activities associated with a Course or CourseInstance, representing the scheduled time students spend in supervised practical or experimental work. Note that the interpretation may depend on the type of entity it is associated with. For a Course the labHours can be indications of the work load of the Course whereas for the CourseInstance the actual number of hours allocated to the course.",
      "rdfs:label": "lab hours",
      "rdfs:range": {
        "@id": "rdfs:Literal"
      },
      "rdfs:subPropertyOf": {
        "@id": "owl:topDataProperty"
      }
    },
    {
      "@id": "edm:language",
      "@type": "owl:DatatypeProperty",
      "owl:deprecated": {
        "@value": true,
        "@type": "xsd:boolean"
      },
      "schema:domainIncludes": {
        "@id": "edm:Work"
      },
      "rdfs:comment": "The language in which the Work is written. This property is deprecated from version 1.3.1 of the EDM to avoid clashes with the language key in json-ld. Please use edm:inLanguage instead.",
      "rdfs:label": "language",
      "rdfs:range": {
        "@id": "xsd:language"
      }
    },
    {
      "@id": "edm:latitude",
      "@type": "owl:DatatypeProperty",
      "schema:domainIncludes": {
        "@id": "edm:GeoLocation"
      },
      "rdfs:comment": "A geographic coordinate that specifies the north-south position of a point on the Earth's surface.",
      "rdfs:label": "latitude",
      "rdfs:subPropertyOf": {
        "@id": "edm:locationLabel"
      }
    },
    {
      "@id": "edm:lectureHours",
      "@type": "owl:DatatypeProperty",
      "schema:domainIncludes": [
        {
          "@id": "edm:Course"
        },
        {
          "@id": "edm:CourseInstance"
        }
      ],
      "rdfs:comment": "The number of hours allocated to instructor-led, classroom-based teaching activities for a Course or CourseInstance, representing the scheduled time spent in lecture-based instruction. Note that the interpretation may depend on the entity it is associated with. For a Course the lecture hours can be the indication of the lecture load of the Course, whereas for the CourseInstance it is the actual number of hours allocated to the course.",
      "rdfs:label": "lecture hours",
      "rdfs:range": {
        "@id": "rdfs:Literal"
      },
      "rdfs:subPropertyOf": {
        "@id": "owl:topDataProperty"
      }
    },
