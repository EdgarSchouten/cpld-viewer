      "schema:domainIncludes": {
        "@id": "edm:CreativeWork"
      },
      "rdfs:comment": "The subtitle of a CreativeWork, such as a Book or an Article. The subtitle is distinct from the `edm:title` and provides additional context, scope or substance to it.",
