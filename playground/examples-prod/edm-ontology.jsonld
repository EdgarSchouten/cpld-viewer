      "rdfs:label": "provided by",
      "owl:inverseOf": {
        "@id": "edm:provides"
      }
    },
    {
      "@id": "edm:providerOf",
      "@type": "owl:ObjectProperty",
      "schema:domainIncludes": {
        "@id": "edm:Organization"
      },
      "schema:rangeIncludes": [
        {
          "@id": "edm:Employment"
        },
        {
          "@id": "edm:Education"
        }
      ],
      "rdfs:comment": "The Organization is the provider of an Activity received by a Person. Relates the entity that provides something by participating in an activity. See receiverOf for a related relation. Not to be confused with providedBy and provides that relate a Service to an Actor.",
      "rdfs:label": "provider of",
      "owl:inverseOf": {
        "@id": "edm:hasProvider"
      }
    },
    {
      "@id": "edm:provides",
      "@type": "owl:ObjectProperty",
      "schema:domainIncludes": {
        "@id": "edm:Actor"
      },
      "schema:rangeIncludes": {
        "@id": "edm:Service"
      },
      "rdfs:comment": "The Actor provides a Service. Not to be confused with providerOf and hasProvider that connect a Organization to an Activity.",
      "rdfs:label": "provides",
      "owl:inverseOf": {
        "@id": "edm:providedBy"
      }
    },
    {
