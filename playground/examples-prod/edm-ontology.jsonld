      "rdfs:subPropertyOf": {
        "@id": "edm:locationLabel"
      }
    },
    {
      "@id": "edm:postalAddressLabel",
      "@type": "owl:DatatypeProperty",
      "schema:domainIncludes": [
        {
          "@id": "edm:Activity"
        },
        {
          "@id": "edm:Organization"
        },
        {
          "@id": "edm:Person"
        }
      ],
      "rdfs:comment": "The postal address as a single piece of text associated with an entity.\nUse the PostalAddress entity type when the address elements are separated out. See attributes that are linked to PostalAddress.",
      "rdfs:label": "postal address label",
      "rdfs:subPropertyOf": {
        "@id": "edm:locationLabel"
      }
    },
    {
      "@id": "edm:postalCode",
      "@type": "owl:DatatypeProperty",
      "schema:domainIncludes": {
        "@id": "edm:PostalAddress"
      },
      "rdfs:comment": "A series of letters, digits or both the specifies a geographic location included in a postal address.",
