  "@graph": [
    {
      "@id": "edm:Absorption",
      "@type": "owl:Class",
      "rdfs:comment": "An activity capturing the linking of two entities whereby an entity absorbs another entity of the same type. The absorbed entity ceases to exist following the absorption, whereas the absorbing entity continues to exist.",
      "rdfs:label": "Absorption",
      "rdfs:subClassOf": {
        "@id": "edm:Activity"
      }
    },
    {
      "@id": "edm:Activity",
      "@type": "owl:Class",
      "rdfs:comment": "An undertaking by one or more Actors, with a specific purpose, usually over a defined period of time.",
      "rdfs:label": "Activity",
      "rdfs:subClassOf": {
        "@id": "edm:Thing"
      }
    },
    {
      "@id": "edm:Actor",
      "@type": "owl:Class",
      "rdfs:comment": "Super-class of entities, such as Person and Organisation or a Software Agent, that may have legal rights, and/or a legal existence, and can undertake a Role.",
      "rdfs:label": "Actor",
      "rdfs:subClassOf": {
        "@id": "edm:Thing"
      }
    },
    {
      "@id": "edm:Affiliation",
      "@type": "owl:Class",
      "rdfs:comment": "The role of an Organization in the context of a Person who has a connection with that Organization. The connection does not include a transfer of entitlements.",
      "rdfs:label": "Affiliation",
      "rdfs:subClassOf": {
        "@id": "edm:Role"
      }
    },
    {
      "@id": "edm:Agreement",
      "@type": "owl:Class",
      "rdfs:comment": "A negotiated and typically legally binding arrangement between Actors as to a course of action.",
      "rdfs:label": "Agreement",
      "rdfs:subClassOf": {
        "@id": "edm:Thing"
      }
    },
    {
      "@id": "edm:AnatomicalStructure",
      "@type": "owl:Class",
      "rdfs:comment": "Any part of a body, typically a component of an anatomical system including organs, tissues, and cells.",
      "rdfs:label": "Anatomical Structure",
      "rdfs:subClassOf": {
        "@id": "edm:Thing"
      }
    },
    {
      "@id": "edm:Annotation",
      "@type": "owl:Class",
      "owl:equivalentClass": "oa:Annotation",
      "rdfs:comment": "An annotation adds extra information associated with a particular point in a document or other piece of information.",
      "rdfs:label": "Annotation",
      "rdfs:subClassOf": {
        "@id": "edm:Thing"
      }
    },
    {
      "@id": "edm:AnnotationSet",
      "@type": "owl:Class",
      "rdfs:comment": "An unordered set of Annotation entities represented as a Graph",
      "rdfs:label": "Annotation Set",
      "rdfs:subClassOf": {
        "@id": "edm:Graph"
      }
    },
    {
      "@id": "edm:Article",
      "@type": "owl:Class",
      "rdfs:comment": "A short-form Work on a particular subject or theme. Often intended for publication in a Journal.",
      "rdfs:label": "Article",
      "rdfs:subClassOf": {
        "@id": "edm:Work"
      }
    },
    {
      "@id": "edm:Association",
      "@type": "owl:Class",
      "rdfs:comment": "The role of an Organization in the context of a Person who has a connection with that Organization. The connection indicates a transfer or propagation of entitlements from the organization to the person.",
      "rdfs:label": "Association",
      "rdfs:subClassOf": {
        "@id": "edm:Role"
      }
    },
    {
      "@id": "edm:Author",
      "@type": "owl:Class",
      "rdfs:comment": "The function of creating or contributing to a Work such as a Book or an Article.",
      "rdfs:label": "Author",
      "rdfs:subClassOf": {
        "@id": "edm:Role"
      }
    },
    {
      "@id": "edm:Awardee",
      "@type": "owl:Class",
      "rdfs:comment": "The function of receiving a Grant Award. This role can be played by an Organization or Person.",
      "rdfs:label": "Awardee",
      "rdfs:subClassOf": {
        "@id": "edm:Role"
      }
    },
    {
      "@id": "edm:BiomedicalResearch",
      "@type": "owl:Class",
      "rdfs:comment": "Research studies and experiments relating to human and veterinary medicine or health, including lab experiments, observational studies and interventional trials and registries, randomized, controlled or not.",
      "rdfs:label": "Biomedical Research",
      "rdfs:subClassOf": {
        "@id": "edm:Experiment"
      }
    },
    {
      "@id": "edm:Book",
      "@type": "owl:Class",
      "rdfs:comment": "A Work containing a detailed exploration of a particular subject. Typically a long form Work containing a sequence of Chapters. Will be assigned an ISBN identifier.",
      "rdfs:label": "Book",
      "rdfs:subClassOf": {
        "@id": "edm:Work"
      }
    },
    {
      "@id": "edm:BookSeries",
      "@type": "owl:Class",
      "rdfs:comment": "A Work comprising a set and/or series of related Books.",
      "rdfs:label": "Book Series",
      "rdfs:subClassOf": {
        "@id": "edm:Work"
      }
    },
    {
      "@id": "edm:Brand",
      "@type": "owl:Class",
      "rdfs:comment": "A brand is a unique identity associated with a product or organization that differentiates it from competitors and influences how it is perceived by customers. Examples of brands include ScienceDirect, Scopus, The Lancet and Elsevier.",
      "rdfs:label": "Brand",
      "rdfs:subClassOf": {
        "@id": "edm:Thing"
      },
      "rdfs:seeAlso": {
        "@id": "https://elsevier.atlassian.net/wiki/spaces/arch/pages/119601568389587/A+Shared+Definition+of+Product"
      }
    },
    {
      "@id": "edm:CarePlan",
      "@type": "owl:Class",
      "rdfs:comment": "A Work describing a care protocol or approach. More specifically, a care plan is a written plan of interprofessional processes of care representing the patient and family's individual needs.",
      "rdfs:label": "Care Plan",
      "rdfs:subClassOf": {
        "@id": "edm:Work"
      }
    },
    {
      "@id": "edm:Chapter",
      "@type": "owl:Class",
      "rdfs:comment": "A main division of a piece of writing that forms part of a Book and may also be referenced individually.",
      "rdfs:label": "Chapter",
      "rdfs:subClassOf": {
        "@id": "edm:Work"
      }
    },
    {
      "@id": "edm:ClinicalOverview",
      "@type": "owl:Class",
      "rdfs:comment": "A synoptic content document for a disease or condition.",
      "rdfs:label": "Clinical Overview",
      "rdfs:subClassOf": {
        "@id": "edm:Work"
      }
    },
    {
      "@id": "edm:ClinicalTrial",
      "@type": "owl:Class",
      "rdfs:comment": "Experiments performed in clinical research including trials of drugs, devices and procedures often regulated and requiring consent.",
      "rdfs:label": "Clinical Trial",
      "rdfs:subClassOf": {
        "@id": "edm:BiomedicalResearch"
      }
    },
    {
      "@id": "edm:Collaboration",
      "@type": "owl:Class",
      "rdfs:comment": "The action of working together, such as to produce Work(s).",
      "rdfs:label": "Collaboration",
      "rdfs:subClassOf": {
        "@id": "edm:Activity"
      }
    },
    {
      "@id": "edm:Comment",
      "@type": "owl:Class",
      "rdfs:comment": "A Comment comprises observations and opinions pertaining to a Work that are associated with particular locations in the Work.",
      "rdfs:label": "Comment",
      "rdfs:subClassOf": {
        "@id": "edm:Work"
      }
    },
    {
      "@id": "edm:CompositeSelector",
      "@type": "owl:Class",
      "rdfs:comment": "Allows to target multiple parts of a text in a single annotation using the edm:composedOf property.",
      "rdfs:label": "Composite Selector",
      "rdfs:subClassOf": {
        "@id": "oa:Selector"
      }
    },
    {
      "@id": "edm:Concept",
      "@type": "owl:Class",
      "rdfs:comment": "A class of Entities that classify other Entities, and the relationships between other Entities, so that similar and related Entities can be recognized, and to allow potential relationships to be deduced. The instances of this class are generally organised into vocabularies, taxonomies and list of values.",
      "rdfs:label": "Concept",
      "rdfs:subClassOf": {
        "@id": "edm:Thing"
      }
    },
    {
      "@id": "edm:Conference",
      "@type": "owl:Class",
      "rdfs:comment": "A gathering of Persons who meet at an arranged place and time in order to discuss or engage in some common interest.",
      "rdfs:label": "Conference",
      "rdfs:subClassOf": {
        "@id": "edm:Activity"
      }
    },
    {
      "@id": "edm:ConferenceContribution",
      "@type": "owl:Class",
      "rdfs:comment": "A Work presented at a Conference. It can include synoptic Work like posters and abstracts as well as full-length papers.",
      "rdfs:label": "Conference Contribution",
      "rdfs:subClassOf": {
        "@id": "edm:Work"
      }
    },
    {
      "@id": "edm:ConferencePaper",
      "@type": "owl:Class",
      "rdfs:comment": "A full-length Article that has been presented at a conference and included in Conference Proceedings.",
      "rdfs:label": "Conference Paper",
      "rdfs:subClassOf": {
        "@id": "edm:ConferenceContribution"
      }
    },
    {
      "@id": "edm:ConferencePoster",
      "@type": "owl:Class",
      "rdfs:comment": "A synoptic Work presented at a Conference usually with a printed poster.",
      "rdfs:label": "Conference Poster",
      "rdfs:subClassOf": {
        "@id": "edm:ConferenceContribution"
      }
    },
    {
      "@id": "edm:ConferenceProceedings",
      "@type": "owl:Class",
      "rdfs:comment": "A collection of Works presented at a Conference (or other type of Activity).",
      "rdfs:label": "Conference Proceedings",
      "rdfs:subClassOf": {
        "@id": "edm:Work"
      }
    },
    {
      "@id": "edm:ConferenceSeries",
      "@type": "owl:Class",
      "rdfs:comment": "A succession of conferences that are organized periodically, often annually or biennially, focusing on a particular field, subject or industry.",
      "rdfs:label": "Conference Series",
      "rdfs:subClassOf": {
        "@id": "edm:Activity"
      }
    },
    {
      "@id": "edm:Contract",
      "@type": "owl:Class",
      "rdfs:comment": "A written agreement, especially one concerning employment, sales, or tenancy, that is intended to be enforceable by law. Eg: a publishing contract. The contract can be associated with Persons or Organizations, Products, Works and Services may be related to it.",
      "rdfs:label": "Contract",
      "rdfs:subClassOf": {
        "@id": "edm:Agreement"
      }
    },
    {
      "@id": "edm:Course",
      "@type": "owl:Class",
      "rdfs:comment": "A Course is an educational offering that exists independently of any particular delivery consisting of a structured set of learning objectives content and assessments. A Course serves as the conceptual template from which specific scheduled CourseInstances are created. A Course may be delivered multiple times and each delivery is represented as a distinct CourseInstance.",
      "rdfs:label": "Course",
      "rdfs:subClassOf": {
        "@id": "edm:CreativeWork"
      }
    },
    {
      "@id": "edm:CourseInstance",
      "@type": "owl:Class",
      "rdfs:comment": "A CourseInstance is a specific realizatio or offering of a Course scheduled at particular dates, locations, or online platforms. It may include details of delivery, and relations to Persons as associated instructors in the role of EducationProfessional and enrolled Students and Organizations as the EducationProviders. CourseInstances may also be part of a wider Education activity associated with a Person in the Student role.",
      "rdfs:label": "Course Instance",
      "rdfs:subClassOf": {
        "@id": "edm:Activity"
      }
    },
    {
      "@id": "edm:CreativeComposition",
      "@type": "owl:Class",
      "rdfs:comment": "Creative Composition refers to original music, literary works, or other structured artistic content. Creative compositions include arranged elements like notes, words, or images in a cohesive and expressive final piece.",
      "rdfs:label": "Creative Composition",
      "rdfs:subClassOf": {
        "@id": "edm:CreativeWork"
      }
    },
    {
      "@id": "edm:CreativePerformance",
      "@type": "owl:Class",
      "rdfs:comment": "A creative performance is a work that is an artistic presentation designed to engage an audience. Examples include theater productions, dance performances, concerts, and spoken word events, where the act of performing is central to the creative experience. Any events that are outcomes or instances of a Creative Performance should be captured as Activities.",
      "rdfs:label": "Creative Performance",
      "rdfs:subClassOf": {
        "@id": "edm:CreativeWork"
      }
    },
    {
      "@id": "edm:CreativeProduction",
      "@type": "owl:Class",
      "rdfs:comment": "A creative production includes physical artistic works, such as films, sculptures, multimedia projects, or installations. These works are generally intended for exhibition or public display, showcasing innovation and craftsmanship.",
      "rdfs:label": "Creative Production",
      "rdfs:subClassOf": {
        "@id": "edm:CreativeWork"
      }
    },
    {
      "@id": "edm:CreativeWork",
      "@type": "owl:Class",
      "rdfs:comment": "A creative work is any original intellectual output that embodies creativity and innovation, including but not limited to scholarly output, artistic expressions, literature, music, movies, photographs, software programs, and design.",
      "rdfs:label": "Creative Work",
      "rdfs:subClassOf": {
        "@id": "edm:Thing"
      },
      "owl:sameAs": {
        "@id": "schema:CreativeWork"
      }
    },
    {
      "@id": "edm:Customer",
      "@type": "owl:Class",
      "rdfs:comment": "The function of purchasing Products by an Actor.",
      "rdfs:label": "Customer",
      "rdfs:subClassOf": {
        "@id": "edm:Role"
      }
    },
    {
      "@id": "edm:Dataset",
      "@type": "owl:Class",
      "rdfs:comment": "A collection of related sets of information that is composed of separate elements but can be manipulated as a unit by a computer.",
      "rdfs:label": "Dataset",
      "rdfs:subClassOf": {
        "@id": "edm:Work"
      }
    },
    {
      "@id": "edm:Degree",
      "@type": "owl:Class",
      "rdfs:comment": "A qualification that a Person is Granted by an Organization, usually at a college or university.",
      "rdfs:label": "Degree",
      "rdfs:subClassOf": {
        "@id": "edm:Thing"
      }
    },
    {
      "@id": "edm:DigitalResource",
      "@type": "owl:Class",
      "rdfs:comment": "A digital resource refers to any non-physical material or tool that is stored, accessed, or transmitted in a digital format. It is usually  access controlled (but need not be).  Examples are digital journal content, and sub-collections thereof, product APIs and features.",
      "rdfs:label": "Digital Resource",
      "rdfs:subClassOf": {
        "@id": "edm:ProductResource"
      },
      "rdfs:seeAlso": {
        "@id": "https://elsevier.atlassian.net/wiki/spaces/arch/pages/119601568389587/A+Shared+Definition+of+Product"
      }
    },
    {
      "@id": "edm:Drug",
      "@type": "owl:Class",
      "rdfs:comment": "Any substance or combination of substances that is used or studied for some intentional pharmacological effect; administered as an aid in the diagnosis, treatment, or prevention of disease or other abnormal condition, for the relief of pain or suffering, to control or improve any physiologic or pathologic condition or that alters the function of the body.",
      "rdfs:label": "Drug",
      "rdfs:subClassOf": {
        "@id": "edm:Thing"
      }
    },
    {
      "@id": "edm:DrugDocument",
      "@type": "owl:Class",
      "rdfs:comment": "A work containing information about a drug, its indication, dosing, contraindication and adverse effects. This may include amongst others drug reports, drug monographs and drug approval documents.",
      "rdfs:label": "Drug Document",
      "rdfs:subClassOf": {
        "@id": "edm:Work"
      }
    },
    {
      "@id": "edm:DrugTarget",
      "@type": "owl:Class",
      "rdfs:comment": "Anything within a living organism to which a drug is directed or binds to resulting in a change in its behavior or function.",
      "rdfs:label": "Drug Target",
      "rdfs:subClassOf": {
        "@id": "edm:Thing"
      }
    },
    {
      "@id": "edm:Editor",
      "@type": "owl:Class",
      "rdfs:comment": "The function of selecting selecting and curating material for inclusion in a Work.",
      "rdfs:label": "Editor",
      "rdfs:subClassOf": {
        "@id": "edm:Role"
      }
    },
    {
      "@id": "edm:Education",
      "@type": "owl:Class",
      "rdfs:comment": "The time-bounded activity that represents the process of a Person receiving education, acquiring knowledge or skills, possibly resulting in a Degree at an Organization providing education (in the role of EducationProvider).",
      "rdfs:label": "Education",
      "rdfs:subClassOf": {
        "@id": "edm:Activity"
      }
    },
    {
      "@id": "edm:EducationProfessional",
      "@type": "owl:Class",
      "rdfs:comment": "The function of a Person providing education services and related activities.",
      "rdfs:label": "Education Professional",
      "rdfs:subClassOf": {
        "@id": "edm:Role"
      }
    },
    {
      "@id": "edm:EducationProvider",
      "@type": "owl:Class",
      "rdfs:comment": "The function of an Organization providing education services and related activities.",
      "rdfs:label": "Education Provider",
      "rdfs:subClassOf": {
        "@id": "edm:Role"
      }
    },
    {
      "@id": "edm:Employment",
      "@type": "owl:Class",
      "rdfs:comment": "The time-bounded activity that represents the employment of a Person by an Organization.",
      "rdfs:label": "Employment",
      "rdfs:subClassOf": {
        "@id": "edm:Activity"
      }
    },
    {
      "@id": "edm:Exhibition",
      "@type": "owl:Class",
      "rdfs:comment": "An exhibition is a curated display of creative works such as artwork, photography, or design pieces. These displays are typically organized for public viewing in galleries, museums, or campus spaces and usually serve an educational or thematic purpose.",
      "rdfs:label": "Exhibition",
      "rdfs:subClassOf": {
        "@id": "edm:CreativeWork"
      }
    },
    {
      "@id": "edm:Experiment",
      "@type": "owl:Class",
      "rdfs:comment": "An experiment is a procedure carried out to support, refute, or validate a hypothesis or in order to investigate and explore phenomena.",
      "rdfs:label": "Experiment",
      "rdfs:subClassOf": {
        "@id": "edm:Activity"
      }
    },
    {
      "@id": "edm:File",
      "@type": "owl:Class",
      "rdfs:comment": "A computer resource for recording data in a computer storage device or in a cloud storage.",
      "rdfs:label": "File",
      "rdfs:subClassOf": {
        "@id": "edm:Thing"
      }
    },
    {
      "@id": "edm:Funder",
      "@type": "owl:Class",
      "rdfs:comment": "A role that played by an Organisation or Person who provides funding.",
      "rdfs:label": "Funder",
      "rdfs:subClassOf": {
        "@id": "edm:Role"
      }
    },
    {
      "@id": "edm:GeoLocation",
      "@type": "owl:Class",
      "rdfs:comment": "The geographic location expressed as a set of coordinates such as latitude, longitude and altitude.",
      "rdfs:label": "GeoLocation",
      "rdfs:subClassOf": {
        "@id": "edm:Location"
      }
    },
    {
      "@id": "edm:GrantAward",
      "@type": "owl:Class",
      "rdfs:comment": "An agreement where a monetary resource is issued to a person or organization by another funding person or organization to perform research activities, often for a particular project. The award document would be a work.",
      "rdfs:label": "Grant Award",
      "rdfs:subClassOf": {
        "@id": "edm:Agreement"
      }
    },
    {
      "@id": "edm:GrantOpportunity",
      "@type": "owl:Class",
      "rdfs:comment": "A monetary resource persons may apply for, which has conditions applicants must adhere to to receive funding.",
      "rdfs:label": "Grant Opportunity",
      "rdfs:subClassOf": {
        "@id": "edm:Agreement"
      }
    },
    {
      "@id": "edm:Graph",
      "@type": "owl:Class",
      "rdfs:comment": "A set of nodes (entities, resources or vertices) and edges (relations or links).",
      "rdfs:label": "Graph",
      "rdfs:subClassOf": {
        "@id": "edm:Thing"
      }
    },
    {
      "@id": "edm:Group",
      "@type": "owl:Class",
      "rdfs:comment": "A grouping of multiple Persons and/or Organizations where the group is a non-legal entity.",
      "rdfs:label": "Group",
      "rdfs:subClassOf": {
        "@id": "edm:Actor"
      }
    },
    {
      "@id": "edm:HealthProfessional",
      "@type": "owl:Class",
      "rdfs:comment": "The function of a Person providing healthcare services and related activities.",
      "rdfs:label": "Health Professional",
      "rdfs:subClassOf": {
        "@id": "edm:Role"
      }
    },
    {
      "@id": "edm:HealthProvider",
      "@type": "owl:Class",
      "rdfs:comment": "The function of an Organization providing healthcare services and related activities.",
      "rdfs:label": "Health Provider",
      "rdfs:subClassOf": {
        "@id": "edm:Role"
      }
    },
    {
      "@id": "edm:Honors",
      "@type": "owl:Class",
      "rdfs:comment": "An achievement or the acknowledgment of contributions by peers, institutions, or organizations in areas such as teaching, research or service. Examples include a Nobel prize, best paper award or a community engagement award.",
      "rdfs:label": "Honors",
      "rdfs:subClassOf": {
        "@id": "edm:Thing"
      }
    },
    {
      "@id": "edm:Issue",
      "@type": "owl:Class",
      "rdfs:comment": "An ordered set of published Articles of a Journal with additional material such as table of contents, advertisements and editorial letters.",
      "rdfs:label": "Issue",
      "rdfs:subClassOf": {
        "@id": "edm:Work"
      }
    },
    {
      "@id": "edm:Journal",
      "@type": "owl:Class",
      "rdfs:comment": "A periodical where the primary content is scholarly articles. It behaves as a container for Articles.",
      "rdfs:label": "Journal",
      "rdfs:subClassOf": {
        "@id": "edm:Work"
      }
    },
    {
      "@id": "edm:KnowledgeAnnotation",
      "@type": "owl:Class",
      "rdfs:comment": "A knowledge annotation is used to link relations between multiple entities in a knowledge graph, to the text/content where they are present.  KnowledgeAnnotation is a special type of Annotation defined by the Content Profile and Linked Document standard.",
      "rdfs:label": "Knowledge Annotation",
      "rdfs:subClassOf": {
        "@id": "edm:Annotation"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://elsevier.atlassian.net/wiki/spaces/arch/pages/87664312340/Content+Profile+and+Linked+Document+Standard"
      }
    },
    {
      "@id": "edm:License",
      "@type": "owl:Class",
      "rdfs:comment": "An agreement specifying the conditions of use of Work(s) Product(s) or Service(s) by unnamed Agent(s).",
      "rdfs:label": "License",
      "rdfs:subClassOf": {
        "@id": "edm:Agreement"
      }
    },
    {
      "@id": "edm:Licensee",
      "@type": "owl:Class",
      "rdfs:comment": "A role borne by an Organization or Person that receives rights or permissions under a license to use, distribute, access, or otherwise exercise rights over intellectual property or other licensed assets.",
      "rdfs:label": "Licensee",
      "rdfs:subClassOf": {
        "@id": "edm:Role"
      }
    },
    {
      "@id": "edm:Licensor",
      "@type": "owl:Class",
      "rdfs:comment": "A role borne by an Organization or Person that grants rights or permissions under a license relating to intellectual property or other licensed assets.",
      "rdfs:label": "Licensor",
      "rdfs:subClassOf": {
        "@id": "edm:Role"
      }
    },
    {
      "@id": "edm:Location",
      "@type": "owl:Class",
      "rdfs:comment": "Location descriptors including postal address and geolocations.",
      "rdfs:label": "Location",
      "rdfs:subClassOf": {
        "@id": "edm:Thing"
      }
    },
    {
      "@id": "edm:MarketingCampaign",
      "@type": "owl:Class",
      "rdfs:comment": "A marketing activity, aimed at a segment of Organizations and Persons, intended to drive awareness, engagement and sales.",
      "rdfs:label": "Marketing Campaign",
      "rdfs:subClassOf": {
        "@id": "edm:Activity"
      }
    },
    {
      "@id": "edm:MediaObject",
      "@type": "owl:Class",
      "rdfs:comment": "A media object is a media file such as an image, video, or audio object.",
      "rdfs:label": "Media Object",
      "rdfs:subClassOf": {
        "@id": "edm:File"
      }
    },
    {
      "@id": "edm:MedicalCondition",
      "@type": "owl:Class",
      "rdfs:comment": "A condition affecting the functioning of the (human) body whether mentally or physically.",
      "rdfs:label": "Medical Condition",
      "rdfs:subClassOf": {
        "@id": "edm:Thing"
      }
    },
    {
      "@id": "edm:MedicalDevice",
      "@type": "owl:Class",
      "rdfs:comment": "An instrument, apparatus, implant, in vitro reagent, or other similar item, or accessory which is intended for use in the diagnosis of disease or other conditions, or in the cure, mitigation, treatment, or prevention of disease, in human or other animals which does not achieve its primary intended purposes through chemical action.",
      "rdfs:label": "Medical Device",
      "rdfs:subClassOf": {
        "@id": "edm:Thing"
      }
    },
    {
      "@id": "edm:MedicalGuideline",
      "@type": "owl:Class",
      "rdfs:comment": "A medical guideline is a document with the aim of guiding decisions and includes criteria regarding diagnosis, management, and treatment in specific areas of healthcare.",
      "rdfs:label": "Medical Guideline",
      "rdfs:subClassOf": {
        "@id": "edm:Work"
      }
    },
    {
      "@id": "edm:MedicalProcedure",
      "@type": "owl:Class",
      "rdfs:comment": "A series of steps by which a desired medical outcome is ideally accomplished.",
      "rdfs:label": "Medical Procedure",
      "rdfs:subClassOf": {
        "@id": "edm:Thing"
      }
    },
    {
      "@id": "edm:MedicalTest",
      "@type": "owl:Class",
      "rdfs:comment": "A test that may be utilized to help diagnosis, and for monitoring and assessment of medical conditions.",
      "rdfs:label": "Medical Test",
      "rdfs:subClassOf": {
        "@id": "edm:MedicalProcedure"
      }
    },
    {
      "@id": "edm:Mentor",
      "@type": "owl:Class",
      "rdfs:comment": "A Person having the role of Mentor in the context of another Person that is being mentored.",
      "rdfs:label": "Mentor",
      "rdfs:subClassOf": {
        "@id": "edm:Role"
      }
    },
    {
      "@id": "edm:Merger",
      "@type": "owl:Class",
      "rdfs:comment": "An activity captures the linking entities whereby two or more entities of the same type merge to form a single entity of that same type at given point in time. The merger leads to the end of the original entities and creation of a new entity.",
      "rdfs:label": "Merger",
      "rdfs:subClassOf": {
        "@id": "edm:Activity"
      }
    },
    {
      "@id": "edm:NarrativeAnnotation",
      "@type": "owl:Class",
      "rdfs:comment": "A narrative annotation is used to specify that a part of the text has a certain role in the narrative of the text, e.g. conclusion, introduction, hypothesis, etc. NarrativeAnnotations are special types of annotations used in Content Profiles and Linked Documents.",
      "rdfs:label": "Narrative Annotation",
      "rdfs:subClassOf": {
        "@id": "edm:Annotation"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://elsevier.atlassian.net/wiki/spaces/arch/pages/87664312340/Content+Profile+and+Linked+Document+Standard"
      }
    },
    {
      "@id": "edm:Name",
      "@type": "owl:Class",
      "rdfs:comment": "Groups the constituent parts of the name of a Person.",
      "rdfs:label": "Name",
      "rdfs:subClassOf": {
        "@id": "edm:Thing"
      }
    },
    {
      "@id": "edm:NonDigitalResource",
      "@type": "owl:Class",
      "rdfs:comment": "A non-digital resource refers to any physical or analog material or tool that is not stored, accessed, or transmitted in a digital format. These resources exist in a tangible form and do not rely on digital technology for their distribution, or use. Non-digital resources do not require access control. Examples are printed books and analog media such as DVDs.",
      "rdfs:label": "Non-Digital Resource",
      "rdfs:subClassOf": {
        "@id": "edm:ProductResource"
      },
      "rdfs:seeAlso": {
        "@id": "https://elsevier.atlassian.net/wiki/spaces/arch/pages/119601568389587/A+Shared+Definition+of+Product"
      }
    },
    {
      "@id": "edm:Organization",
      "@type": "owl:Class",
      "rdfs:comment": "An organization, or organisation, is an entity - such as a company, an institution, or an association - comprising one or more people and having a particular purpose. (see https://en.wikipedia.org/wiki/Organization). An Organization may have relationships with other Organizations and with Persons.",
      "rdfs:label": "Organization",
      "rdfs:subClassOf": {
        "@id": "edm:Actor"
      }
    },
    {
      "@id": "edm:Participation",
      "@type": "owl:Class",
      "owl:deprecated": {
        "@value": true,
        "@type": "xsd:boolean"
      },
      "rdfs:comment": "This entity type is deprecated. Actor participating in an Activity.",
      "rdfs:label": "Participation",
      "rdfs:subClassOf": {
        "@id": "edm:Relationship"
      }
    },
    {
      "@id": "edm:Participant",
      "@type": "owl:Class",
      "rdfs:comment": "The Role of an Actor participating in an Activity.",
      "rdfs:label": "Participant",
      "rdfs:subClassOf": {
        "@id": "edm:Role"
      }
    },
    {
      "@id": "edm:Patent",
      "@type": "owl:Class",
      "rdfs:comment": "A document describing an invention which assigns rights to an inventor (Person and/or Organization).",
      "rdfs:label": "Patent",
      "rdfs:subClassOf": {
        "@id": "edm:Work"
      }
    },
    {
      "@id": "edm:Patient",
      "@type": "owl:Class",
      "rdfs:comment": "A person receiving or registered to receive medical treatment.",
      "rdfs:label": "Patient",
      "rdfs:subClassOf": {
        "@id": "edm:Role"
      }
    },
    {
      "@id": "edm:PatientEducation",
      "@type": "owl:Class",
      "rdfs:comment": "Any materials such as documents, pamphlets or videos aimed at Patients providing information about a medical condition, treatment or drug.",
      "rdfs:label": "Patient Education",
      "rdfs:subClassOf": {
        "@id": "edm:Work"
      }
    },
    {
      "@id": "edm:Person",
      "@type": "owl:Class",
      "rdfs:comment": "An individual human being.  A Person can be engaged in many different ways, from using and purchasing Products, or being a potential user of Products, through being involved in the process of creating Works, having various relationships with other People and Organizations, to being a significant individual in their field.",
      "rdfs:label": "Person",
      "rdfs:subClassOf": {
        "@id": "edm:Actor"
      }
    },
    {
      "@id": "edm:PostalAddress",
      "@type": "owl:Class",
      "rdfs:comment": "A collection of information such as city and street name used to describe the location associated with an entity.",
      "rdfs:label": "Postal Address",
      "rdfs:subClassOf": {
        "@id": "edm:Location"
      }
    },
    {
      "@id": "edm:Product",
      "@type": "owl:Class",
      "rdfs:comment": "A product is something that is manufactured or created to be sold to, exchanged with or used by another actor. It can be a physical entity, a service, a digital offering, etc. or a combination, that is aimed at satisfying a need or want of internal or external consumers. Products represent value, both for the consumer and the producer. Product management is not a necessary condition but can be in place.",
      "rdfs:label": "Product",
      "rdfs:subClassOf": {
        "@id": "edm:Thing"
      },
      "rdfs:seeAlso": {
        "@id": "https://elsevier.atlassian.net/wiki/spaces/arch/pages/119601568389587/A+Shared+Definition+of+Product"
      }
    },
    {
      "@id": "edm:ProductPlatform",
      "@type": "owl:Class",
      "rdfs:comment": "A product platform, is one or more software systems that allow the delivery of multiple (saleable) product variations or derivatives, in support of a brand. It has a modular design that allows for customization or configuration to meet different customer needs or market segments. Examples include Sciencedirect.com, Scopus.com and ClinicalKey.com.",
      "rdfs:label": "Product Platform",
      "rdfs:subClassOf": {
        "@id": "edm:SoftwareSystem"
      },
      "rdfs:seeAlso": {
        "@id": "https://elsevier.atlassian.net/wiki/spaces/arch/pages/119601568389587/A+Shared+Definition+of+Product"
      }
    },
    {
      "@id": "edm:ProductResource",
      "@type": "owl:Class",
      "rdfs:comment": "A Product resource is any thing that constitutes the value of a product offering (or multiple products). The resource is the thing that should be made accessible to the consumers of the product. In the base case a given resource represents a given product. In more complex cases there may be multiple resources that represent different product aspects and elements. Product resources are specified as a part of product definition. Examples include product APIs, books, journal content platforms and features.",
      "rdfs:label": "Product Resource",
      "rdfs:subClassOf": {
        "@id": "edm:Thing"
      },
      "rdfs:seeAlso": {
        "@id": "https://elsevier.atlassian.net/wiki/spaces/arch/pages/119601568389587/A+Shared+Definition+of+Product"
      }
    },
    {
      "@id": "edm:Project",
      "@type": "owl:Class",
      "rdfs:comment": "An activity involving one or more participants for the sake of researching or achieving a given objective, with a start date (and eventual end date).",
      "rdfs:label": "Project",
      "rdfs:subClassOf": {
        "@id": "edm:Activity"
      }
    },
    {
      "@id": "edm:Publisher",
      "@type": "owl:Class",
      "rdfs:comment": "An Organization or Person engaging in the dissemination of Work.",
      "rdfs:label": "Publisher",
      "rdfs:subClassOf": {
        "@id": "edm:Role"
      }
    },
    {
      "@id": "edm:QualityAssessment",
      "@type": "owl:Class",
      "rdfs:comment": "A grouping of one or more quality statements or metrics that belong together because they were produced in the same assessment context and share the same provenance, method, or interpretation. A QualityAssessment is intended to group metrics that make sense together, for example confidence, completeness, precision, accuracy, or qualitative judgments, especially when they were generated by the same process, source, model, or curator activity. The specific metrics contained in the assessment may be defined in other vocabularies.",
      "rdfs:label": "Quality Assessment",
      "rdfs:subClassOf": {
        "@id": "edm:Thing"
      }
    },
    {
      "@id": "edm:Relationship",
      "@type": "owl:Class",
      "owl:deprecated": {
        "@value": true,
        "@type": "xsd:boolean"
      },
      "rdfs:comment": "This entity type is deprecated. Super-class of entities, including Association and Affiliation, that describe a relationship between Entities with defined semantics.",
      "rdfs:label": "Relationship",
      "rdfs:subClassOf": {
        "@id": "edm:Thing"
      }
    },
    {
      "@id": "edm:ResearchData",
      "@type": "owl:Class",
      "rdfs:comment": "Data that is the outcome of research activities that includes research results in a relatively raw form frequently lacking a narrative.",
      "rdfs:label": "Research Data",
      "rdfs:subClassOf": {
        "@id": "edm:Work"
      }
    },
    {
      "@id": "edm:Researcher",
      "@type": "owl:Class",
      "rdfs:comment": "The function of performing research or working on a research project.",
      "rdfs:label": "Researcher",
      "rdfs:subClassOf": {
        "@id": "edm:Role"
      }
    },
    {
      "@id": "edm:Review",
      "@type": "owl:Class",
      "rdfs:comment": "A critique of a Work written by a Reviewer.",
      "rdfs:label": "Review",
      "rdfs:subClassOf": {
        "@id": "edm:Work"
      }
    },
    {
      "@id": "edm:Reviewer",
      "@type": "owl:Class",
      "rdfs:comment": "The function of reviewing a Work.",
      "rdfs:label": "Reviewer",
      "rdfs:subClassOf": {
        "@id": "edm:Role"
      }
    },
    {
      "@id": "edm:RightsHolder",
      "@type": "owl:Class",
      "rdfs:comment": "Person or Organization owning or managing property rights, including intellectual property rights over the resource.",
      "rdfs:label": "RightsHolder",
      "rdfs:subClassOf": {
        "@id": "edm:Role"
      }
    },
    {
      "@id": "edm:Role",
      "@type": "owl:Class",
      "rdfs:comment": "A function performed by an Actor in Relation to a Work or an Activity.",
      "rdfs:label": "Role",
      "rdfs:subClassOf": {
        "@id": "edm:Thing"
      }
    },
    {
      "@id": "edm:SaleableProduct",
      "@type": "owl:Class",
      "rdfs:comment": "An (Elsevier) saleable product is defined as a (current, historical or future) marketable \u201cgood or service\u201d, that we intend to sell to more than one customer. A saleable product may or may not be chargeable (i.e.: may be zero cost) and it is expected to appear on an invoice at line item level.",
      "rdfs:label": "Saleable Product",
      "rdfs:subClassOf": {
        "@id": "edm:Product"
      },
      "rdfs:seeAlso": {
        "@id": "https://elsevier.atlassian.net/wiki/spaces/arch/pages/119601568389587/A+Shared+Definition+of+Product"
      }
    },
    {
      "@id": "edm:Schema",
      "@type": "owl:Class",
      "rdfs:comment": "A data structure described in a formal language that may include constraints that the underlying data (in a DataSet) must fulfil.",
      "rdfs:label": "Schema",
      "rdfs:subClassOf": {
        "@id": "edm:Work"
      }
    },
    {
      "@id": "edm:SemanticAnnotation",
      "@type": "owl:Class",
      "rdfs:comment": "A SemanticAnnotation is used to capture meaning in the text as an externally described entity or resource. The text can mention (edm:mentions) that entity, render structured information (edm:renditionOf), or indirectly be about that entity (edm:hasSubject).",
      "rdfs:label": "Semantic Annotation",
      "rdfs:subClassOf": {
        "@id": "edm:Annotation"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://elsevier.atlassian.net/wiki/spaces/arch/pages/87664312340/Content+Profile+and+Linked+Document+Standard"
      }
    },
    {
      "@id": "edm:Separation",
      "@type": "owl:Class",
      "rdfs:comment": "Activity capturing the linking of entities whereby an entity separates from another entity, the latter continuing to exist and the former coming into existence. Both entities are of the same type.",
      "rdfs:label": "Separation",
      "rdfs:subClassOf": {
        "@id": "edm:Activity"
      }
    },
    {
      "@id": "edm:Service",
      "@type": "owl:Class",
      "rdfs:comment": "A function or capability that can be performed. A Service can be offered for sale as a part of a Product.",
      "rdfs:label": "Service",
      "rdfs:subClassOf": {
        "@id": "edm:Thing"
      }
    },
    {
      "@id": "edm:ShortWorkForm",
      "@type": "owl:Class",
      "rdfs:comment": "A short work form is a concise piece of writing, such as an abstract or summary, that distils the key findings, arguments, and contributions of a larger research project or study.",
      "rdfs:label": "Short Work Form",
      "rdfs:subClassOf": {
        "@id": "edm:Work"
      }
    },
    {
      "@id": "edm:SoftwareAgent",
      "@type": "owl:Class",
      "rdfs:comment": "A computer program that acts without requiring direct input from humans.",
      "rdfs:label": "Software Agent",
      "rdfs:subClassOf": {
        "@id": "edm:Actor"
      }
    },
    {
      "@id": "edm:SoftwareSystem",
      "@type": "owl:Class",
      "rdfs:comment": "A software system is a cohesive set of interconnected technology assets designed, developed, and maintained by a development or support team. A system provides value to its users (whether they are human or not) through its functionality and services. The system's boundary aligns with a team's scope, allowing team members to independently modify the system's internal implementation details.",
      "rdfs:label": "Software System",
      "rdfs:subClassOf": {
        "@id": "edm:TechnologyAsset"
      },
      "rdfs:seeAlso": {
        "@id": "https://elsevier.atlassian.net/wiki/spaces/arch/pages/119601568389587/A+Shared+Definition+of+Product"
      }
    },
    {
      "@id": "edm:Split",
      "@type": "owl:Class",
      "rdfs:comment": "Activity capturing the linking of entities whereby a single entity splits to form two or more new entities of the same type. The split ends the original entity and leads to two or more new entities.",
      "rdfs:label": "Split",
      "rdfs:subClassOf": {
        "@id": "edm:Activity"
      }
    },
    {
      "@id": "edm:StructureAnnotation",
      "@type": "owl:Class",
      "rdfs:comment": "Structure annotations can be used as alternative to the HTML5 representation of a document and allows to define the position of HTML elements against a plain text representation. A StructureAnnotation is a special type of Annotation defined by the Content Profile and Linked Document Standard.",
      "rdfs:label": "Structure Annotation",
      "rdfs:subClassOf": {
        "@id": "edm:Annotation"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://elsevier.atlassian.net/wiki/spaces/arch/pages/87664312340/Content+Profile+and+Linked+Document+Standard"
      }
    },
    {
      "@id": "edm:Student",
      "@type": "owl:Class",
      "rdfs:comment": "The function of a Person receiving education services.",
      "rdfs:label": "Student",
      "rdfs:subClassOf": {
        "@id": "edm:Role"
      }
    },
    {
      "@id": "edm:Subject",
      "@type": "owl:Class",
      "owl:deprecated": {
        "@value": true,
        "@type": "xsd:boolean"
      },
      "rdfs:comment": "A Concept that is the subject or topic of another entity. A Concept can be the topic of a Work.",
      "rdfs:label": "Subject",
      "rdfs:subClassOf": {
        "@id": "edm:Role"
      }
    },
    {
      "@id": "edm:Substance",
      "@type": "owl:Class",
      "rdfs:comment": "A substance is a form of matter having broadly consistent chemical composition and characteristic properties whose origin may be biological, mineral or chemical.",
      "rdfs:label": "Substance",
      "rdfs:subClassOf": {
        "@id": "edm:Thing"
      }
    },
    {
      "@id": "edm:Succession",
      "@type": "owl:Class",
      "rdfs:comment": "Activity capturing the linking of entities whereby an entity succeeds another entity. The change occurs because characteristics of original entity have changed affecting its identity leading to its replacement.",
      "rdfs:label": "Succession",
      "rdfs:subClassOf": {
        "@id": "edm:Activity"
      }
    },
    {
      "@id": "edm:SyntaxAnnotation",
      "@type": "owl:Class",
      "rdfs:comment": "A syntax annotation is used to specify that some part of the text is a syntactic unit in natural language. SyntaxAnnotations are special types of Annotations used in Content Profiles and Linked Documents.",
      "rdfs:label": "Syntax Annotation",
      "rdfs:subClassOf": {
        "@id": "edm:Annotation"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://elsevier.atlassian.net/wiki/spaces/arch/pages/87664312340/Content+Profile+and+Linked+Document+Standard"
      }
    },
    {
      "@id": "edm:TechnologyAsset",
      "@type": "owl:Class",
      "rdfs:comment": "A technology asset refers to any technological resource or component that is owned, controlled, or utilized by an individual or organization for the purpose of creating value or achieving strategic objectives. Technology assets can include hardware, software, data, intellectual property, proprietary systems, networks, infrastructure, and other technological resources.",
      "rdfs:label": "Technology Asset",
      "rdfs:subClassOf": {
        "@id": "edm:Thing"
      },
      "rdfs:seeAlso": {
        "@id": "https://elsevier.atlassian.net/wiki/spaces/arch/pages/119601568389587/A+Shared+Definition+of+Product"
      }
    },
    {
      "@id": "edm:Thesis",
      "@type": "owl:Class",
      "rdfs:comment": "A Work authored by a Person in support of candidature for an academic Degree or professional qualification.",
      "rdfs:label": "Thesis",
      "rdfs:subClassOf": {
        "@id": "edm:Work"
      }
    },
    {
      "@id": "edm:Thing",
      "@type": "owl:Class",
      "rdfs:comment": "A superclass entity for the Elsevier Data Model, not intended to be directly used as a class.",
      "rdfs:label": "Thing"
    },
    {
      "@id": "edm:User",
      "@type": "owl:Class",
      "rdfs:comment": "An Actor, typically Person, that interacts with a Service or Product.",
      "rdfs:label": "User",
      "rdfs:subClassOf": {
        "@id": "edm:Role"
      }
    },
    {
      "@id": "edm:Vocabulary",
      "@type": "owl:Class",
      "rdfs:comment": "A collection of Concepts, also called Knowledge Organizing System (KOS) that may include hierarchies and relations between Concepts.",
      "rdfs:label": "Vocabulary",
      "rdfs:subClassOf": {
        "@id": "edm:Work"
      }
    },
    {
      "@id": "edm:Work",
      "@type": "owl:Class",
      "rdfs:comment": "An article, book or other similar creative work. Works can span a wide range of sizes, from small digests, through to multi-part constructs like encyclopedias and journals. Works can be offered for sale as a part of a Product.",
      "rdfs:label": "Work",
      "rdfs:subClassOf": {
        "@id": "edm:CreativeWork"
      }
    },
    {
      "@id": "edm:WorkingPaper",
      "@type": "owl:Class",
      "rdfs:comment": "A scientific Work that has not undergone peer-review such as a preprint or article that may never be published as an official publication.",
      "rdfs:label": "Working Paper",
      "rdfs:subClassOf": {
        "@id": "edm:Work"
      }
    },
    {
      "@id": "edm:absorbed",
      "@type": "owl:ObjectProperty",
      "schema:domainIncludes": {
        "@id": "edm:Thing"
      },
      "schema:rangeIncludes": {
        "@id": "edm:Thing"
      },
      "rdfs:comment": "Connects two entities where entity A absorbs entity B. Entity A existed prior to the absorption and continues to exist whereas entity B ceases to exist upon its absorption into A.",
      "rdfs:label": "absorbed",
      "owl:equivalentProperty": "http://id.loc.gov/ontologies/bibframe/absorbed",
      "owl:inverseOf": {
        "@id": "edm:absorbedBy"
      }
    },
    {
      "@id": "edm:absorbedBy",
      "@type": "owl:ObjectProperty",
      "schema:domainIncludes": {
        "@id": "edm:Thing"
      },
      "schema:rangeIncludes": {
        "@id": "edm:Thing"
      },
      "rdfs:comment": "Connects two entities of the same type, where entity A is absorbed by entity B. Entity A ceases to exist upon its absorption whereas entity B existed prior to the absorption and continues to exist.",
      "rdfs:label": "absorbed by",
      "owl:equivalentProperty": "http://id.loc.gov/ontologies/bibframe/absorbedBy",
      "owl:inverseOf": {
        "@id": "edm:absorbed"
      }
    },
    {
      "@id": "edm:abstract",
      "@type": "owl:DatatypeProperty",
      "schema:domainIncludes": {
        "@id": "edm:Work"
      },
      "rdfs:comment": "The summary of the Work.",
      "rdfs:label": "abstract",
      "rdfs:range": {
        "@id": "rdfs:Literal"
      },
      "rdfs:subPropertyOf": {
        "@id": "edm:description"
      }
    },
    {
      "@id": "edm:acronym",
      "@type": "owl:DatatypeProperty",
      "schema:domainIncludes": [
        {
          "@id": "edm:Organization"
        },
        {
          "@id": "edm:Journal"
        },
                {
          "@id": "edm:Activity"
        },
        {
          "@id": "edm:Course"
        }
      ],
      "rdfs:comment": "The acronym of an entity, such as an Organization or a Journal.",
      "rdfs:label": "acronym",
      "rdfs:range": {
        "@id": "rdfs:Literal"
      },
      "rdfs:subPropertyOf": {
        "@id": "edm:label"
      }
    },
    {
      "@id": "edm:addressCountry",
      "@type": "owl:DatatypeProperty",
      "schema:domainIncludes": {
        "@id": "edm:PostalAddress"
      },
      "rdfs:comment": "The country used in postal addresses.\nFor other uses of country please use edm:country",
      "rdfs:label": "address country",
      "rdfs:subPropertyOf": {
        "@id": "edm:locationLabel"
      }
    },
    {
      "@id": "edm:addressLocality",
      "@type": "owl:DatatypeProperty",
      "schema:domainIncludes": {
        "@id": "edm:PostalAddress"
      },
      "rdfs:comment": "The locality such as the settlement name.",
      "rdfs:label": "address locality",
      "rdfs:subPropertyOf": {
        "@id": "edm:locationLabel"
      }
    },
    {
      "@id": "edm:addressRegion",
      "@type": "owl:DatatypeProperty",
      "schema:domainIncludes": {
        "@id": "edm:PostalAddress"
      },
      "rdfs:comment": "The administrative region or area used in postal addresses.",
      "rdfs:label": "address region",
      "rdfs:subPropertyOf": {
        "@id": "edm:locationLabel"
      }
    },
    {
      "@id": "edm:adverseEffectOf",
      "@type": "owl:ObjectProperty",
      "schema:domainIncludes": {
        "@id": "edm:MedicalCondition"
      },
      "schema:rangeIncludes": {
        "@id": "edm:Drug"
      },
      "rdfs:comment": "The MedicalCondition is the adverse effect or side effect of the Drug.",
      "rdfs:label": "adverse effect of",
      "owl:inverseOf": {
        "@id": "edm:hasAdverseEffect"
      }
    },
    {
      "@id": "edm:affiliationOf",
      "@type": "owl:ObjectProperty",
      "schema:domainIncludes": {
        "@id": "edm:Organization"
      },
      "schema:rangeIncludes": {
        "@id": "edm:Person"
      },
      "rdfs:comment": "The Organization is linked to the Person without transferring entitlements to that Person.",
      "rdfs:label": "affiliation of",
      "owl:inverseOf": {
        "@id": "edm:hasAffiliation"
      }
    },
    {
      "@id": "edm:alternateLabel",
      "@type": "owl:DatatypeProperty",
      "schema:domainIncludes": {
        "@id": "edm:Thing"
      },
      "rdfs:comment": "An alternate label for the entity.",
      "rdfs:label": "alternate label",
      "rdfs:range": {
        "@id": "rdfs:Literal"
      },
      "rdfs:subPropertyOf": {
        "@id": "edm:label"
      }
    },
    {
      "@id": "edm:alternateName",
      "@type": "rdf:Property",
      "schema:domainIncludes": [
        {
          "@id": "edm:Actor"
        },
        {
          "@id": "edm:Product"
        }
      ],
      "rdfs:comment": "An alternate name for the Actor or Product.",
      "rdfs:label": "alternate name",
      "schema:rangeIncludes": [
        {
          "@id": "rdfs:Literal"
        },
        {
          "@id": "edm:Name"
        }
      ],
      "rdfs:subPropertyOf": {
        "@id": "edm:name"
      }
    },
    {
      "@id": "edm:altitude",
      "@type": "owl:DatatypeProperty",
      "schema:domainIncludes": {
        "@id": "edm:GeoLocation"
      },
      "rdfs:comment": "The height of a Thing above a reference level, especially above sea level or above the earth's surface.",
      "rdfs:label": "altitude",
      "rdfs:subPropertyOf": {
        "@id": "edm:locationLabel"
      }
    },
    {
      "@id": "edm:annotatedBy",
      "@type": "owl:ObjectProperty",
      "schema:domainIncludes": {
        "@id": "oa:Target"
      },
      "schema:rangeIncludes": {
        "@id": "oa:Body"
      },
      "rdfs:comment": "The Target (e.g. some piece of text, some entity) is annotated by the Body.",
      "rdfs:label": "annotated by",
      "owl:inverseOf": {
        "@id": "edm:annotates",
        "@type": "owl:ObjectProperty",
        "rdfs:comment": "The Body annotates some piece of text, some entity (the Target)",
        "rdfs:label": "annotates"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://elsevier.atlassian.net/wiki/spaces/arch/pages/87664312340/Content+Profile+and+Linked+Document+Standard"
      }
    },
    {
      "@id": "edm:associatedAnatomy",
      "@type": "owl:ObjectProperty",
      "schema:domainIncludes": {
        "@id": "edm:MedicalCondition"
      },
      "schema:rangeIncludes": {
        "@id": "edm:AnatomicalStructure"
      },
      "rdfs:comment": "The MedicalCondition is connected to the AnatomicalStructure.",
      "rdfs:label": "associated anatomy",
      "owl:inverseOf": {
        "@id": "edm:relatedCondition"
      }
    },
    {
      "@id": "edm:associatedWith",
      "@type": "owl:ObjectProperty",
      "schema:domainIncludes": [
        {
          "@id": "edm:Organization"
        },
        {
          "@id": "edm:Person"
        }
      ],
      "schema:rangeIncludes": {
        "@id": "edm:Organization"
      },
      "rdfs:comment": "The Person or Organization is linked to the Organization with transfer of entitlements from the Organization.",
      "rdfs:label": "associated with",
      "owl:inverseOf": {
        "@id": "edm:hasAssociation"
      }
    },
    {
      "@id": "edm:authorOf",
      "@type": "owl:ObjectProperty",
      "schema:domainIncludes": {
        "@id": "edm:Actor"
      },
      "schema:rangeIncludes": {
        "@id": "edm:Work"
      },
      "rdfs:comment": "The Actor is the Author of the Work.",
      "rdfs:label": "author of",
      "owl:inverseOf": {
        "@id": "edm:hasAuthor"
      }
    },
    {
      "@id": "edm:availableOnlineDate",
      "@type": "owl:DatatypeProperty",
      "schema:domainIncludes": {
        "@id": "edm:Work"
      },
      "rdfs:comment": "The date the Work was made available online for the first time. The availableOnlineDate may apply to any Work including those that have not been, and may never be, formally published by a publisher such as WorkingPapers.",
      "rdfs:label": "available online date",
      "rdfs:range": {
        "@id": "xsd:dateTime"
      },
      "rdfs:subPropertyOf": {
        "@id": "edm:date"
      }
    },
    {
      "@id": "edm:awardedTo",
      "@type": "owl:ObjectProperty",
      "schema:domainIncludes": {
        "@id": "edm:GrantAward"
      },
      "schema:rangeIncludes": [
        {
          "@id": "edm:Organization"
        },
        {
          "@id": "edm:Person"
        }
      ],
      "rdfs:comment": "The GrantAward is awarded to a Person or Organization.",
      "rdfs:label": "awarded to",
      "owl:inverseOf": {
        "@id": "edm:hasAward"
      }
    },
    {
      "@id": "edm:birthDate",
      "@type": "owl:DatatypeProperty",
      "schema:domainIncludes": {
        "@id": "edm:Person"
      },
      "rdfs:comment": "The date a Person was born.",
      "rdfs:label": "birth date",
      "rdfs:range": {
        "@id": "xsd:date"
      },
      "rdfs:subPropertyOf": {
        "@id": "edm:date"
      }
    },
    {
      "@id": "edm:brand",
      "@type": "owl:DatatypeProperty",
      "schema:domainIncludes": {
        "@id": "edm:Product"
      },
      "rdfs:comment": "The brand associated with the Product.",
      "rdfs:label": "brand",
      "rdfs:range": {
        "@id": "rdfs:Literal"
      },
      "rdfs:subPropertyOf": {
        "@id": "edm:name"
      }
    },
    {
      "@id": "edm:casNumber",
      "@type": "owl:DatatypeProperty",
      "owl:deprecated": {
        "@value": true,
        "@type": "xsd:boolean"
      },
      "schema:domainIncludes": {
        "@id": "edm:Substance"
      },
      "rdfs:comment": "This attribute is deprecated. Please use edm:identifier in combination with the correct identifier type from the Identifier Type Registry. A numerical identifier assigned by the Chemical Abstracts Service (CAS) to every chemical substance described in the open scientific literature.",
      "rdfs:label": "CAS number",
      "rdfs:subPropertyOf": {
        "@id": "edm:identifier"
      }
    },
    {
      "@id": "edm:checksum",
      "@type": "owl:DatatypeProperty",
      "schema:domainIncludes": [
        {
          "@id": "edm:Dataset"
        },
        {
          "@id": "edm:ResearchData"
        }
      ],
      "rdfs:comment": "A checksum of the data following RFC 6920.",
      "rdfs:label": "checksum"
    },
    {
      "@id": "edm:commentOf",
      "@type": "owl:ObjectProperty",
      "schema:domainIncludes": {
        "@id": "edm:Comment"
      },
      "schema:rangeIncludes": {
        "@id": "edm:Work"
      },
      "rdfs:comment": "The Comment is associated with the Work or a particular segment of the Work.",
      "rdfs:label": "comment of",
      "owl:inverseOf": {
        "@id": "edm:hasComment"
      }
    },
    {
      "@id": "edm:composedOf",
      "@type": "owl:ObjectProperty",
      "schema:domainIncludes": {
        "@id": "edm:CompositeSelector"
      },
      "schema:rangeIncludes": {
        "@id": "oa:Selector"
      },
      "rdfs:comment": "Indicates that the composite selector is composed of another selector. Inverse relation is intentionally omitted.",
      "rdfs:label": "composed of"
    },
    {
      "@id": "edm:conformsTo",
      "@type": "owl:DatatypeProperty",
      "schema:domainIncludes": [
        {
          "@id": "edm:Dataset"
        },
        {
          "@id": "edm:File"
        },
        {
          "@id": "edm:MediaObject"
        }
      ],
      "rdfs:comment": "Specifies the schema of the dataset or media object using either a relative location or absolute location through a URL.",
      "rdfs:label": "conforms to",
      "schema:rangeIncludes": [
        {
          "@id": "xsd:string"
        },
        {
          "@id": "xsd:anyURI"
        }
      ]
    },
    {
      "@id": "edm:contextOf",
      "@type": "owl:ObjectProperty",
      "schema:domainIncludes": {
        "@id": "edm:Thing"
      },
      "schema:rangeIncludes": [
        {
          "@id": "edm:Agreement"
        },
        {
          "@id": "edm:Role"
        }
      ],
      "rdfs:comment": "Associates an entity with a Role or Agreement that is defined within its context. The entity provides the contextual scope for the Role or Agreement, while the Role or Agreement describes how an Actor participates with respect to that entity. For example, edm:Article edm:contextOf edm:Author and edm:Author edm:roleOf edm:Person. In this case the Article provides the context for the Author role, and the role relates the Person to the Article as its author.",
      "rdfs:label": "context of",
      "owl:inverseOf": {
        "@id": "edm:hasContext"
      }
    },
    {
      "@id": "edm:continuedBy",
      "@type": "owl:ObjectProperty",
      "schema:domainIncludes": {
        "@id": "edm:Thing"
      },
      "schema:rangeIncludes": {
        "@id": "edm:Thing"
      },
      "rdfs:comment": "Connects two entities of the same type where the change in name affects the identity of the entity. Entity A ceases to exist because of its name change and is continued by entity B with a new name which then comes into existence. Examples are journals where the title changes and it becomes a new journal.",
      "rdfs:label": "continued by",
      "rdfs:subPropertyOf": "edm:succeededBy",
      "owl:equivalentProperty": "http://id.loc.gov/ontologies/bibframe/continuedBy",
      "owl:inverseOf": {
        "@id": "edm:continues"
      }
    },
    {
      "@id": "edm:continuedInPartBy",
      "@type": "owl:ObjectProperty",
      "schema:domainIncludes": {
        "@id": "edm:Thing"
      },
      "schema:rangeIncludes": {
        "@id": "edm:Thing"
      },
      "rdfs:comment": "Connects two entities of the same type where entity A is continued in part by entity B. Entity A continues to exist after the separation of B whereas entity B did not exist prior to the separation.",
      "rdfs:label": "continued in part by",
      "owl:equivalentProperty": "http://id.loc.gov/ontologies/bibframe/continuedInPartBy",
      "owl:inverseOf": {
        "@id": "edm:separatedFrom"
      }
    },
    {
      "@id": "edm:continues",
      "@type": "owl:ObjectProperty",
      "schema:domainIncludes": {
        "@id": "edm:Thing"
      },
      "schema:rangeIncludes": {
        "@id": "edm:Thing"
      },
      "rdfs:comment": "Connects two entities of the same type where the change in name affects the identity of the entity. Entity A comes into existence when the name of entity B changes and entity B ceases to exist; entity A continues entity B. Examples are journals where the title changes and it becomes a new journal.",
      "rdfs:label": "continues",
      "rdfs:subPropertyOf": "edm:precededBy",
      "owl:equivalentProperty": "http://id.loc.gov/ontologies/bibframe/continues",
      "owl:inverseOf": {
        "@id": "edm:continuedBy"
      }
    },
    {
      "@id": "edm:continuesInPart",
      "@type": "owl:ObjectProperty",
      "schema:domainIncludes": {
        "@id": "edm:Thing"
      },
      "schema:rangeIncludes": {
        "@id": "edm:Thing"
      },
      "rdfs:comment": "Connects entities of the same type where entity A is a partial continuation of entity B as the result of a split and there is at least one other entity that is also connected to entity B through the continuesInPart relation. Entity A comes into existence upon the time of the split whereas Entity B ceases to exist.",
      "rdfs:label": "continues in part",
      "owl:equivalentProperty": "http://id.loc.gov/ontologies/bibframe/continuesInPart",
      "owl:inverseOf": {
        "@id": "edm:splitInto"
      }
    },
    {
      "@id": "edm:contraIndicationOf",
      "@type": "owl:ObjectProperty",
      "schema:domainIncludes": {
        "@id": "edm:MedicalCondition"
      },
      "schema:rangeIncludes": [
        {
          "@id": "edm:Drug"
        },
        {
          "@id": "edm:MedicalProcedure"
        }
      ],
      "rdfs:comment": "The MedicalCondition is an indication that the Drug or MedicalProcedure should not be used.",
      "rdfs:label": "contraindication of",
      "owl:inverseOf": {
        "@id": "edm:hasContraIndication"
      }
    },
    {
      "@id": "edm:copyrightLine",
      "@type": "owl:DatatypeProperty",
      "schema:domainIncludes": {
        "@id": "edm:Work"
      },
      "rdfs:comment": "The copyright line of the Work.",
      "rdfs:label": "copyright line",
      "rdfs:range": {
        "@id": "rdfs:Literal"
      },
      "rdfs:subPropertyOf": {
        "@id": "owl:topDataProperty"
      }
    },
    {
      "@id": "edm:copyrightYear",
      "@type": "owl:DatatypeProperty",
      "schema:domainIncludes": {
        "@id": "edm:Work"
      },
      "rdfs:comment": "The copyright year of the Work.",
      "rdfs:label": "copyright year",
      "rdfs:range": {
        "@id": "xsd:gYear"
      },
      "rdfs:subPropertyOf": {
        "@id": "edm:date"
      }
    },
    {
      "@id": "edm:country",
      "@type": "owl:DatatypeProperty",
      "schema:domainIncludes": {
        "@id": "edm:Thing"
      },
      "rdfs:comment": "The country associated with the entity.\nFor postal addresses use edm:addressCountry.",
      "rdfs:label": "country",
      "rdfs:subPropertyOf": {
        "@id": "edm:locationLabel"
      }
    },
    {
      "@id": "edm:courseCode",
      "@type": "owl:DatatypeProperty",
      "schema:domainIncludes": [
        {
          "@id": "edm:Course"
        },
        {
          "@id": "edm:CourseInstance"
        }
      ],
      "rdfs:comment": "A course code is the identifier of the Course assigned by the course provider such as a catalog code, subject code, or course number. Please note that this identifier is not necessarily unique and therefore this property does not qualify for the Identifier Type Registry. Different course providers may use the same code to identify different courses.",
      "rdfs:label": "course code",
      "rdfs:range": {
        "@id": "rdfs:Literal"
      },
      "rdfs:subPropertyOf": {
        "@id": "edm:identifier"
      }
    },
    {
      "@id": "edm:courseCredit",
      "@type": "owl:DatatypeProperty",
      "schema:domainIncludes": [
        {
          "@id": "edm:Course"
        },
        {
          "@id": "edm:CourseInstance"
        }
      ],
      "rdfs:comment": "A quantitative measure of the academic credit or workload value assigned to a Course or CourseInstance, indicating the amount of learning effort or credit hours students earn upon successful completion.",
      "rdfs:label": "course credit",
      "rdfs:range": {
        "@id": "rdfs:Literal"
      },
      "rdfs:subPropertyOf": {
        "@id": "owl:topDataProperty"
      }
    },
    {
      "@id": "edm:courseDesignation",
      "@type": "owl:DatatypeProperty",
      "schema:domainIncludes": [
        {
          "@id": "edm:Course"
        },
        {
          "@id": "edm:CourseInstance"
        }
      ],
      "rdfs:comment": "A descriptive label or classification assigned to a Course and its CourseInstances that conveys its academic category, requirement status, or curricular designation such as a general education area, level or subject designation. Examples are  `L` for lab, `H` for honors.",
      "rdfs:label": "course designation",
      "rdfs:range": {
        "@id": "rdfs:Literal"
      },
      "rdfs:subPropertyOf": {
        "@id": "owl:topDataProperty"
      }
    },
    {
      "@id": "edm:courseLevel",
      "@type": "owl:DatatypeProperty",
      "schema:domainIncludes": [
        {
          "@id": "edm:Course"
        },
        {
          "@id": "edm:CourseInstance"
        }
      ],
      "rdfs:comment": "A classification indicating the academic level or degree of advancement of a Course and its CourseInstances such as: introductory, intermediate, advanced, undergraduate or graduate. The course level situates the course within the Organization's hierarchy of curriculum progression or difficulty.",
      "rdfs:label": "course level",
      "rdfs:range": {
        "@id": "rdfs:Literal"
      },
      "rdfs:subPropertyOf": {
        "@id": "owl:topDataProperty"
      }
    },
    {
      "@id": "edm:courseSection",
      "@type": "owl:DatatypeProperty",
      "schema:domainIncludes": [
        {
          "@id": "edm:Course"
        },
        {
          "@id": "edm:CourseInstance"
        }
      ],
      "rdfs:comment": "Course section identifies a specific offering of a Course within an academic period or term. It typically distinguishes parallel offerings of the course held in the same term that occur at diferent times or given by different instructors. For example:  05 is the course section in the course  ENG 101 `\u2013` Section 05",
      "rdfs:label": "course section",
      "rdfs:range": {
        "@id": "rdfs:Literal"
      },
      "rdfs:subPropertyOf": {
        "@id": "edm:identifier"
      }
    },
    {
      "@id": "edm:createdDate",
      "@type": "owl:DatatypeProperty",
      "schema:domainIncludes": {
        "@id": "edm:Work"
      },
      "rdfs:comment": "The date or time the Work was created.",
      "rdfs:label": "created date",
      "rdfs:subPropertyOf": {
        "@id": "edm:date"
      }
    },
    {
      "@id": "edm:creatorOf",
      "@type": "owl:ObjectProperty",
      "schema:domainIncludes": {
        "@id": "edm:Actor"
      },
      "schema:rangeIncludes": {
        "@id": "edm:CreativeWork"
      },
      "rdfs:comment": "The Actor is the creator of the CreativeWork.",
      "rdfs:label": "creator of",
      "owl:inverseOf": {
        "@id": "edm:hasCreator"
      }
    },
    {
      "@id": "edm:date",
      "@type": "owl:DatatypeProperty",
      "schema:domainIncludes": {
        "@id": "edm:Thing"
      },
      "rdfs:comment": "The date associated with the entity.",
      "rdfs:label": "date",
      "rdfs:range": {
        "@id": "xsd:dateTime"
      },
      "rdfs:subPropertyOf": {
        "@id": "owl:topDataProperty"
      }
    },
    {
      "@id": "edm:deathDate",
      "@type": "owl:DatatypeProperty",
      "schema:domainIncludes": {
        "@id": "edm:Person"
      },
      "rdfs:comment": "The date a Person died.",
      "rdfs:label": "death date",
      "rdfs:range": {
        "@id": "xsd:date"
      },
      "rdfs:subPropertyOf": {
        "@id": "edm:date"
      }
    },
    {
      "@id": "edm:denotedByConcept",
      "@type": "owl:ObjectProperty",
      "schema:domainIncludes": {
        "@id": "owl:Class"
      },
      "schema:rangeIncludes": [
        {
          "@id": "edm:Concept"
        },
        {
          "@id": "skos:Concept"
        }
      ],
      "rdfs:comment": "A Class is denoted by a Concept, bridging the ontological and the terminological layer.",
      "rdfs:label": "denoted by",
      "owl:inverseOf": {
        "@id": "edm:denotesClass"
      }
    },
    {
      "@id": "edm:denotesClass",
      "@type": "owl:ObjectProperty",
      "schema:domainIncludes": [
        {
          "@id": "edm:Concept"
        },
        {
          "@id": "skos:Concept"
        }
      ],
      "schema:rangeIncludes": {
        "@id": "owl:Class"
      },

      "rdfs:comment": "A Concept denotes a Class, bridging the terminological and the ontological layer.",
      "rdfs:label": "denotes",
      "owl:inverseOf": {
        "@id": "edm:denotedByConcept"
      }
    },   
    { 
      "@id": "edm:derivedFrom",
      "@type": "owl:ObjectProperty",
      "schema:domainIncludes": {
        "@id": "edm:CreativeWork"
      },
      "schema:rangeIncludes": {
        "@id": "edm:CreativeWork"
      },
      "rdfs:comment": "A CreativeWork is derived from another CreativeWork.",
      "rdfs:label": "derived from",
      "owl:inverseOf": {
        "@id": "edm:hasDerivation"
      }
    },
    {
      "@id": "edm:description",
      "@type": "owl:DatatypeProperty",
      "schema:domainIncludes": {
        "@id": "edm:Thing"
      },
      "rdfs:comment": "A description associated with an entity.",
      "rdfs:label": "description",
      "rdfs:range": {
        "@id": "rdfs:Literal"
      }
    },
    {
      "@id": "edm:deviceUsed",
      "@type": "owl:ObjectProperty",
      "schema:domainIncludes": {
        "@id": "edm:MedicalDevice"
      },
      "schema:rangeIncludes": [
        {
          "@id": "edm:MedicalProcedure"
        },
        {
          "@id": "edm:Role"
        }
      ],
      "rdfs:comment": "MedicalDevice used in MedicalProcedure or Role.",
      "rdfs:label": "device used",
      "owl:inverseOf": {
        "@id": "edm:usesDevice"
      }
    },
    {
      "@id": "edm:doi",
      "@type": "owl:DatatypeProperty",
      "owl:deprecated": {
        "@value": true,
        "@type": "xsd:boolean"
      },
      "schema:domainIncludes": {
        "@id": "edm:Work"
      },
      "rdfs:comment": "This attribute is deprecated. Please use edm:identifier in combination with the correct identifier type from the Identifier Type Registry. Digital Object Identifier or DOI is a persistent resolvable identifier used to identify objects such as journal articles, research data and reviews.",
      "rdfs:label": "doi",
      "rdfs:range": {
        "@id": "rdfs:Literal"
      },
      "rdfs:subPropertyOf": {
        "@id": "edm:identifier"
      }
    },
    {
      "@id": "edm:duration",
      "@type": "owl:DatatypeProperty",
      "schema:domainIncludes": {
        "@id": "edm:Activity"
      },
      "rdfs:comment": "The duration of an Activity.",
      "rdfs:label": "duration",
      "rdfs:range": {
        "@id": "xsd:duration"
      }
    },
    {
      "@id": "edm:edition",
      "@type": "owl:DatatypeProperty",
      "schema:domainIncludes": {
        "@id": "edm:Book"
      },
      "rdfs:comment": "The edition of the Book.",
      "rdfs:label": "edition",
      "rdfs:range": {
        "@id": "rdfs:Literal"
      }
    },
    {
      "@id": "edm:editorOf",
      "@type": "owl:ObjectProperty",
      "schema:domainIncludes": {
        "@id": "edm:Person"
      },
      "schema:rangeIncludes": {
        "@id": "edm:Work"
      },
      "rdfs:comment": "The Person is an Editor of the Work.",
      "rdfs:label": "editor of",
      "owl:inverseOf": {
        "@id": "edm:hasEditor"
      }
    },
    {
      "@id": "edm:educatedAt",
      "@type": "owl:ObjectProperty",
      "schema:domainIncludes": {
        "@id": "edm:Person"
      },
      "schema:rangeIncludes": {
        "@id": "edm:Organization"
      },
      "rdfs:comment": "The relation from a Person to the Organization where they received their education. The Person is educated at an Organization.",
      "rdfs:label": "educated at",
      "owl:inverseOf": {
        "@id": "edm:hasLearner"
      }
    },
    {
      "@id": "edm:emailAddress",
      "@type": "owl:DatatypeProperty",
