        {
          "@id": "edm:Product"
        },
        {
          "@id": "edm:Thing"
        },
        {
          "@id": "edm:Activity"
        }
      ],
      "rdfs:comment": "The entity of a given type is included in another entity of a given type. For example: a Work is included in a Product, a Substance is included in a Drug.",
      "rdfs:label": "included in",
      "owl:inverseOf": {
        "@id": "edm:includes"
      }
    },
    {
      "@id": "edm:includes",
      "@type": "owl:ObjectProperty",
      "schema:domainIncludes": [
        {
          "@id": "edm:Drug"
        },
        {
          "@id": "edm:Product"
        },
        {
          "@id": "edm:Thing"
        },
        {
          "@id": "edm:Activity"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "edm:Service"
        },
        {
          "@id": "edm:Substance"
        },
        {
          "@id": "edm:Thing"
        },
        {
          "@id": "edm:Work"
        }
      ],
      "rdfs:comment": "The entity includes other types of entity(ies). For example: a Product includes Works or Services; Drug includes Substances.",
      "rdfs:label": "includes",
      "owl:inverseOf": {
        "@id": "edm:includedIn"
      }
    },
    {
      "@id": "edm:indicationOf",
