      "@id": "edm:issn",
      "@type": "owl:DatatypeProperty",
      "owl:deprecated": {
        "@value": true,
        "@type": "xsd:boolean"
      },
      "schema:domainIncludes": {
        "@id": "edm:Journal"
      },
      "rdfs:comment": "This attribute is deprecated. Please use edm:identifier in combination with the correct identifier type from the Identifier Type Registry. The issn of a Journal. Note: If the entity is an Article use edm:partOfISSN to store the ISSN of the parent Journal. This attribute is used to provide the identifier of the entity.",
      "rdfs:label": "issn",
      "rdfs:range": {
        "@id": "rdfs:Literal"
      },
      "rdfs:subPropertyOf": {
