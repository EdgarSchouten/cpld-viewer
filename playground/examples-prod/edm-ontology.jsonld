      "@type": "owl:DatatypeProperty",
      "owl:deprecated": {
        "@value": true,
        "@type": "xsd:boolean"
      },
      "schema:domainIncludes": {
        "@id": "edm:Substance"
      },
      "rdfs:comment": "This attribute is deprecated. Please use edm:identifier in combination with the correct identifier type from the Identifier Type Registry. The simplified molecular-input line-entry system (SMILES) is a specification in form of a line notation for describing the structure of chemical species using short ASCII strings.",
      "rdfs:label": "SMILES",
      "rdfs:subPropertyOf": {
        "@id": "edm:identifier"
      }
    },
    {
      "@id": "edm:sourceParticipantOf",
      "@type": "owl:ObjectProperty",
      "schema:domainIncludes": {
        "@id": "edm:Thing"
      },
