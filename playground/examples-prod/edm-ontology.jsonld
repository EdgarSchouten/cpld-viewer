      },
      "rdfs:comment": "This relation links the Person to a CourseInstance in the capacity of an EducationProfessional. It expresses the instructional responsibility from the perspective of the Person, indicating the CourseInstances that an individual teaches, facilitates, or otherwise delivers.",
      "rdfs:label": "instructor of",
      "owl:inverseOf": {
        "@id": "edm:hasInstructor"
      }
    },
    {
      "@id": "edm:inSupportOf",
      "@type": "owl:ObjectProperty",
      "schema:domainIncludes": [
