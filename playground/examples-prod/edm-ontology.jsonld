      },
      "schema:rangeIncludes": [
        {
          "@id": "edm:Degree"
        },
        {
          "@id": "edm:Honors"
        }
      ],
      "rdfs:comment": "The person, group or organization holds a Degree or Honors.",
      "rdfs:label": "holds",
      "owl:inverseOf": {
        "@id": "edm:heldBy"
      }
    },
    {
      "@id": "edm:homePage",
      "@type": "owl:DatatypeProperty",
      "schema:domainIncludes": {
        "@id": "edm:Actor"
      },
      "rdfs:comment": "The home page of an entity or associated with an entity.",
