        },
        {
          "@id": "edm:File"
        },
        {
          "@id": "edm:MediaObject"
        }
      ],
      "rdfs:comment": "The absolute or relative location of the dataset or media object. The value may be a URL or a string and should be specified in the schema of the Dataset, File or MediaObject.",
      "rdfs:label": "locator",
      "schema:rangeIncludes": [
        {
          "@id": "xsd:string"
        },
        {
          "@id": "xsd:anyURI"
        }
      ]
    },
    {
      "@id": "edm:logo",
      "@type": "owl:DatatypeProperty",
      "schema:domainIncludes": {
        "@id": "edm:Product"
      },
