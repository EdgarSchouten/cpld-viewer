    {
      "@id": "edm:mentorOf",
      "@type": "owl:ObjectProperty",
      "schema:domainIncludes": [
        {
          "@id": "edm:Person"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "edm:Person"
        }
      ],
      "rdfs:comment": "Relationship connecting a Person to another Person where the first has the role of Mentor.",
      "rdfs:label": "mentor of",
