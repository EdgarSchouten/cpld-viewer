      "@type": "owl:DatatypeProperty",
      "schema:domainIncludes": {
        "@id": "edm:Thing"
      },
      "rdfs:comment": "A webpage associated with the entity.",
      "rdfs:label": "link",
      "rdfs:range": {
        "@id": "xsd:anyURI"
      }
    },
    {
      "@id": "edm:locationLabel",
      "@type": "owl:DatatypeProperty",
      "schema:domainIncludes": {
        "@id": "edm:Activity"
      },
      "rdfs:comment": "The location as a piece of text where the Activity is held.\nUse the Location entity type when coordinates are separated out. See attributes that are linked with Location.",
      "rdfs:label": "location label"
    },
    {
      "@id": "edm:locator",
      "@type": "owl:DatatypeProperty",
      "schema:domainIncludes": [
