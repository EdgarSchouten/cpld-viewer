      }
    },
    {
      "@id": "edm:postalDistributionCode",
      "@type": "owl:DatatypeProperty",
      "schema:domainIncludes": {
        "@id": "edm:PostalAddress"
      },
      "rdfs:comment": "An alphanumeric indication of a specific distribution centre or subdivision of a large postal district included in a postal address. It facilitates logistics for mail routing and high volume mail receivers, it is distinct from `postalCode` and can't be derived from it. Typically associated with the postal addresses of an Organization.",
      "rdfs:label": "postal distribution code",
      "rdfs:subPropertyOf": {
        "@id": "edm:locationLabel"
      }
    },
    {
      "@id": "edm:precededBy",
      "@type": "owl:ObjectProperty",
      "schema:domainIncludes": {
        "@id": "edm:Thing"
      },
      "schema:rangeIncludes": {
        "@id": "edm:Thing"
      },
      "rdfs:comment": "Connects two entities of the same type where the change in its characteristics affects the identity of the entity. Entity A is preceded by entity B where as a result of some change entity B ceases to exist and entity A comes into existence.",
