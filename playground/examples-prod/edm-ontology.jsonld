        "@id": "edm:Thing"
      },
      "rdfs:comment": "Indicates that the Target is a textual representation of a known entity",
      "rdfs:label": "rendition of",
      "rdfs:isDefinedBy": {
        "@id": "https://elsevier.atlassian.net/wiki/spaces/arch/pages/87664312340/Content+Profile+and+Linked+Document+Standard"
      },
      "owl:inverseOf": {
        "@id": "edm:hasRendition",
