        },
        {
          "@id": "edm:Separation"
        },
        {
          "@id": "edm:Split"
        },
        {
          "@id": "edm:Succession"
        }
      ],
      "rdfs:comment": "The relation between an entity of origin and the Activity and affects the entity, i.e. the entity that existed prior to the activity. Relates the target entity to the activity. See targetParticipantOf for the relation connecting the source entity.",
      "rdfs:label": "source participant of",
      "owl:inverseOf": {
        "@id": "edm:hasSourceParticipant"
      }
    },
    {
      "@id": "edm:splitInto",
      "@type": "owl:ObjectProperty",
      "schema:domainIncludes": {
        "@id": "edm:Thing"
      },
      "schema:rangeIncludes": {
        "@id": "edm:Thing"
      },
      "rdfs:comment": "Connects entities where entity A is split into entity B and at least another entity of the same type. Entity A ceases to exist upon the time of the split whereas entity B and any other entity(ies) come into existence.",
      "rdfs:label": "split into",
      "owl:equivalentProperty": "http://id.loc.gov/ontologies/bibframe/splitInto",
      "owl:inverseOf": {
        "@id": "edm:continuesInPart"
