      }
    },
    {
      "@id": "edm:hasContext",
      "@type": "owl:ObjectProperty",
      "schema:domainIncludes": [
        {
          "@id": "edm:Agreement"
        },
        {
          "@id": "edm:Role"
        }
      ],
      "schema:rangeIncludes": {
        "@id": "edm:Thing"
      },
      "rdfs:comment": "Associates a Role or Agreement with the Thing that establishes its contextual scope. The Thing represents the entity to which the Role pertains or within which the Agreement applies. For example, edm:Person edm:hasRole edm:Author and edm:Author edm:hasContext edm:Article. In this case the Article provides the context for the Author role, and the role relates the Person to the Article as its author.",
      "rdfs:label": "has context",
      "owl:inverseOf": {
        "@id": "edm:contextOf"
      }
    },
    {
      "@id": "edm:hasContraIndication",
