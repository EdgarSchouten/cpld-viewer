      },
      "rdfs:comment": "The work phone number associated with the actor",
      "rdfs:label": "work phone number",
      "schema:rangeIncludes": [
        {
          "@id": "rdfs:Literal"
        }
      ],
      "rdfs:subPropertyOf": {
        "@id": "edm:telephoneNumber"
      }
    },
    {
      "dcat:keyword": [
        "URA",
        "Top ontology"
      ],
      "dcat:theme": "Architecture",
      "dct:created": "2018-02-18",
      "dct:description": "The Elsevier Data Model (EDM) is a fundamental component of the reference architecture of the enterprise and a part of the URA (Unified reference Architecture). It sets the foundation for a data ecosystem that aims to spans the whole of Elsevier, to enable connectivity and insight, and help value to be achieved.  The EDM establish a core set of entity types for across the organisation in a consistent manner such as People and Organisations, and foundational business and product concepts such as Product, Customer. Author and Editor.  The EDM seeks only to include abstractions of the key relationships and properties, and not to represent the full complexity of all possible scenarios. The Elsevier Data Model does not include highly specialised entity types that are only of interest to a very specific domain (e.g. Bioassay), instead these are expected to be included in domain models, which are mapped to the EDM. The EDM also seeks to provide the upper ontology that connects data silos, leading towards a Linked Data view of the enterprise and enterprise data.",
      "dct:modified": {
        "@value": "2026-02-27",
        "type": "xsd:date"
      },
      "dct:source": "https://github.com/elsevier-centraltechnology/architecture-elsevier-data-model/",
      "foaf:homepage": [
        "https://elsevier.atlassian.net/wiki/spaces/arch/pages/87655662851/Elsevier+Data+Model+Standard",
        "https://data.elsevier.com/schema/edm/",
        "https://data.arch.elsevier.systems/schema/edm/"
      ],
      "id": "edm:",
      "owl:priorVersion": {
        "@value": "https://data.elsevier.com/schema/edm/2.4.6/",
        "type": "xsd:anyURI"
      },
      "owl:versionIRI": {
        "@value": "https://data.elsevier.com/schema/edm/2.4.8/",
        "type": "xsd:anyURI"
      },
      "owl:versionInfo": "2.4.8",
      "pav:lastUpdateOn": {
        "@value": "2026-02-27",
        "type": "xsd:date"
      },
      "rdfs:label": "Elsevier Data Model (EDM)",
      "type": "owl:Ontology",
      "vann:preferredNamespacePrefix": "edm",
      "vann:preferredNamespaceUri": "https://data.elsevier.com/schema/edm/"
    },
