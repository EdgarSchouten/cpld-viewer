        }
      ],
      "rdfs:comment": "The Thesis is in support of a Degree.",
      "rdfs:label": "in support of",
      "owl:inverseOf": {
        "@id": "edm:supportedBy"
      }
    },
    {
      "@id": "edm:isElement",
      "@type": "owl:ObjectProperty",
      "rdfs:subPropertyOf": {
        "@id": "edm:annotatedBy"
      },
      "schema:domainIncludes": {
        "@id": "oa:Target"
      },
      "schema:rangeIncludes": {
        "@id": "oa:Body"
      },
