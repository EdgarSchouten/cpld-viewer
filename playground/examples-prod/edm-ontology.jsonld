      "rdfs:label": "has mentor",
      "owl:inverseOf": {
        "@id": "edm:mentorOf"
      }
    },
    {
      "@id": "edm:hasNarrativeRole",
      "@type": "owl:ObjectProperty",
      "schema:domainIncludes": {
        "@id": "oa:Target"
      },
      "schema:rangeIncludes": {
        "@id": "skos:Concept"
      },
      "rdfs:comment": "Indicates that the target Target is a part of the text has a certain role in the narrative, represented as a skos:Concept defined in a vocabulary, e.g. conclusion, introduction, hypothesis, etc.",
      "rdfs:label": "has narrative role",
      "rdfs:isDefinedBy": {
        "@id": "https://elsevier.atlassian.net/wiki/spaces/arch/pages/87664312340/Content+Profile+and+Linked+Document+Standard"
      }
    },
    {
      "@id": "edm:hasOutcome",
      "@type": "owl:ObjectProperty",
      "schema:domainIncludes": [
        {
          "@id": "edm:Activity"
        },
        {
          "@id": "edm:GrantAward"
        }
      ],
      "schema:rangeIncludes": {
        "@id": "edm:Work"
      },
      "rdfs:comment": "The Activity or GrantAward has a Work as outcome. For example, an article describing the outcomes of an experiment.",
      "rdfs:label": "has outcome",
      "owl:inverseOf": {
        "@id": "edm:outcomeOf"
      }
    },
    {
      "@id": "edm:hasOwner",
      "@type": "owl:ObjectProperty",
      "schema:domainIncludes": [
        {
          "@id": "edm:Dataset"
        },
        {
          "@id": "edm:File"
        },
        {
          "@id": "edm:MediaObject"
        },
        {
          "@id": "edm:Patent"
        },
        {
          "@id": "edm:Product"
        },
        {
          "@id": "edm:TechnologyAsset"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "edm:Person"
        },
        {
          "@id": "edm:Group"
        },
        {
          "@id": "edm:Organization"
        }
      ],
      "rdfs:comment": "Associates an entity such as Patent, Product, Dataset amongst others with its owner. In a dataset metadata file the owner may be identified with an IRI based on the Elsevier or RELX email address.",
      "rdfs:label": "has owner",
      "owl:inverseOf": {
        "@id": "edm:owns"
      }
    },
    {
      "@id": "edm:hasPart",
      "@type": "owl:ObjectProperty",
      "schema:domainIncludes": {
        "@id": "edm:Thing"
      },
      "schema:rangeIncludes": {
        "@id": "edm:Thing"
      },
      "rdfs:comment": "The entity has another entity as its part.",
      "rdfs:label": "has part",
      "owl:inverseOf": {
        "@id": "edm:partOf"
      }
    },
    {
      "@id": "edm:hasParticipant",
      "@type": "owl:ObjectProperty",
      "schema:domainIncludes": [
        {
          "@id": "edm:Activity"
        },
        {
          "@id": "edm:Agreement"
        }
      ],
      "schema:rangeIncludes": {
        "@id": "edm:Actor"
      },
      "rdfs:comment": "The Activity or Agreement has participants.",
      "rdfs:label": "has participant",
      "owl:inverseOf": {
        "@id": "edm:participates"
      }
    },
    {
      "@id": "edm:hasPostalAddress",
      "@type": "owl:ObjectProperty",
      "schema:domainIncludes": [
        {
          "@id": "edm:Activity"
        },
        {
          "@id": "edm:Organization"
        },
        {
          "@id": "edm:Person"
        },
        {
          "@id": "edm:Thing"
        }
      ],
      "schema:rangeIncludes": {
        "@id": "edm:PostalAddress"
      },
      "rdfs:comment": "The entity has a PostalAddress associated with it. The inverse relation is intentionally omitted as instances of PostalAddress are not treated as entities across Elsevier (no indexing or deduplication).",
      "rdfs:label": "has postal address"
    },
    {
      "@id": "edm:hasProvider",
      "@type": "owl:ObjectProperty",
      "schema:domainIncludes": [
        {
          "@id": "edm:Employment"
        },
        {
          "@id": "edm:Education"
        }
      ],
      "schema:rangeIncludes": {
        "@id": "edm:Organization"
      },
      "rdfs:comment": "The relation from an Activity to the Organization that provides the activity. An Activity has provider Organization. The Organization participates in the Activity. See hasReceiver; a closely related relation. Not to be confused with provides and providedBy that relate an Actor to a Service.",
      "rdfs:label": "has provider",
      "owl:inverseOf": {
        "@id": "edm:providerOf"
      }
    },
    {
      "@id": "edm:hasPublisher",
      "@type": "owl:ObjectProperty",
      "schema:domainIncludes": {
        "@id": "edm:CreativeWork"
      },
      "schema:rangeIncludes": {
        "@id": "edm:Organization"
      },
      "rdfs:comment": "The CreativeWork is published by an Organization.",
      "rdfs:label": "has publisher",
      "owl:inverseOf": {
        "@id": "edm:publisherOf"
      }
    },
    {
      "@id": "edm:hasRealization",
      "@type": "owl:ObjectProperty",
      "schema:domainIncludes": [
        {
          "@id": "edm:CreativeWork"
        }
      ],
      "schema:rangeIncludes": {
        "@id": "edm:Activity"
      },
      "rdfs:comment": "This relation links a Creative Work (such as a Course, CreativePerformance, or other abstract CreativeWork) to a real-world Activity that concretely realizes, delivers, or performs it. Examples are: a Course such as Chemistry 101 that is designed and described as a Creative Work and various CourseInstances that are taught across various terms; a CreativeComposition such as Tchaikovsky's `The Nutcracker` and a specific ballet performance at a certain time performed by The Dutch National Ballet which is an Activity.",
      "rdfs:label": "has realization",
      "owl:inverseOf": {
        "@id": "edm:realizationOf"
      }
    },
    {
      "@id": "edm:hasReceiver",
      "@type": "owl:ObjectProperty",
      "schema:domainIncludes": [
        {
          "@id": "edm:Employment"
        },
        {
          "@id": "edm:Education"
        }
      ],
      "schema:rangeIncludes": {
        "@id": "edm:Person"
      },
      "rdfs:comment": "The relation between an Activity and the Person that receives something through the activity. Relates the entity that receives something by participating in an activity. See hasProvider for a closely related relation.",
      "rdfs:label": "has receiver",
      "owl:inverseOf": {
        "@id": "edm:receiverOf"
      }
    },
    {
      "@id": "edm:hasReview",
      "@type": "owl:ObjectProperty",
      "schema:domainIncludes": {
        "@id": "edm:Work"
      },
      "schema:rangeIncludes": {
        "@id": "edm:Review"
      },
      "rdfs:comment": "The Work is associated with its Review.",
      "rdfs:label": "has review",
      "owl:inverseOf": {
        "@id": "edm:reviewOf"
      }
    },
    {
      "@id": "edm:hasReviewer",
      "@type": "owl:ObjectProperty",
      "schema:domainIncludes": {
        "@id": "edm:Work"
      },
      "schema:rangeIncludes": {
        "@id": "edm:Person"
      },
      "rdfs:comment": "The Work is associated with the Person who performed the Review.",
      "rdfs:label": "has reviewer",
      "owl:inverseOf": {
        "@id": "edm:reviewerOf"
      }
    },
    {
      "@id": "edm:hasRole",
      "@type": "owl:ObjectProperty",
      "schema:domainIncludes": {
        "@id": "edm:Actor"
      },
      "schema:rangeIncludes": {
        "@id": "edm:Role"
      },
      "rdfs:comment": "The Actor has a particular Role. This relation used with `edm:hasContext` allows the capturing of more information about the Role an Actor plays in the context of something else. There is an explicit directionality: Actor hasRole Role, Role hasContext Thing. For example: A Person hasRole Author, Author contextOf Book. In this case information about the authorship can be associated with the Author entity instance, whereas `edm:hasAuthor` captures the direct relationship between a Person and a Book.",
      "rdfs:label": "has role",
      "owl:inverseOf": {
        "@id": "edm:roleOf"
      }
    },
    {
      "@id": "edm:hasSchema",
      "@type": "owl:ObjectProperty",
      "schema:domainIncludes": [
        {
          "@id": "edm:Dataset"
        },
        {
          "@id": "edm:Vocabulary"
        }
      ],
      "schema:rangeIncludes": {
        "@id": "edm:Schema"
      },
      "rdfs:comment": "The Dataset, or Vocabulary is based on the Schema.",
      "rdfs:label": "has schema",
      "owl:inverseOf": {
        "@id": "edm:schemaOf"
      }
    },
    {
      "@id": "edm:hasSourceParticipant",
      "@type": "owl:ObjectProperty",
      "schema:domainIncludes": [
        {
          "@id": "edm:Absorption"
        },
        {
          "@id": "edm:Merger"
        },
        {
          "@id": "edm:Separation"
        },
        {
          "@id": "edm:Split"
        },
        {
          "@id": "edm:Succession"
        }
      ],
      "schema:rangeIncludes": {
        "@id": "edm:Thing"
      },
      "rdfs:comment": "The relation between an Activity and the entity that participates in the activity as the source or original entity, i.e. the entity that existed prior to the activity. Relates the source entity to the activity. See hasTargetParticipant for the relation connecting the target entity.",
      "rdfs:label": "has source participant",
      "owl:inverseOf": {
        "@id": "edm:sourceParticipantOf"
      }
    },
    {
      "@id": "edm:hasSubject",
      "@type": "owl:ObjectProperty",
      "schema:domainIncludes": {
        "@id": "edm:Thing"
      },
      "schema:rangeIncludes": {
        "@id": "edm:Concept"
      },
      "rdfs:comment": "The entity has as Subject the Concept.",
      "rdfs:label": "has subject",
      "owl:inverseOf": {
        "@id": "edm:subjectOf"
      }
    },
    {
      "@id": "edm:hasSyntax",
      "@type": "owl:ObjectProperty",
      "schema:domainIncludes": {
        "@id": "oa:Target"
      },
      "schema:rangeIncludes": {
        "@id": "skos:Concept"
      },
      "rdfs:comment": "Indicates that the Target is a syntactic unit (natural language) specified by a skos:Concept defined in a vocabulary. This is a short form for the SyntaxAnnotation",
      "rdfs:label": "syntax",
      "rdfs:isDefinedBy": {
        "@id": "https://elsevier.atlassian.net/wiki/spaces/arch/pages/87664312340/Content+Profile+and+Linked+Document+Standard"
      }
    },
    {
      "@id": "edm:hasTargetParticipant",
      "@type": "owl:ObjectProperty",
      "schema:domainIncludes": [
        {
          "@id": "edm:Absorption"
        },
        {
          "@id": "edm:Merger"
        },
        {
          "@id": "edm:Separation"
        },
        {
          "@id": "edm:Split"
        },
        {
          "@id": "edm:Succession"
        }
      ],
      "schema:rangeIncludes": {
        "@id": "edm:Thing"
      },
      "rdfs:comment": "The relation between an Activity and the entity that participates in the activity as the target or new entity, i.e. the entity that comes into existence after the activity. Relates the target entity to the activity. See hasSourceParticipant for the relation connecting the source entity.",
      "rdfs:label": "has target participant",
      "owl:inverseOf": {
        "@id": "edm:targetParticipantOf"
      }
    },
    {
      "@id": "edm:heldBy",
      "@type": "owl:ObjectProperty",
