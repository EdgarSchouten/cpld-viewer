      "rdfs:comment": "The frequency with which an entity such as a dataset or a vocabulary is being updated.",
      "rdfs:label": "update frequency"
    },
    {
      "@id": "edm:usesDevice",
      "@type": "owl:ObjectProperty",
      "schema:domainIncludes": [
        {
          "@id": "edm:MedicalProcedure"
        },
        {
          "@id": "edm:Role"
        }
      ],
      "schema:rangeIncludes": {
        "@id": "edm:MedicalDevice"
      },
      "rdfs:comment": "The MedicalProcedure, or Role uses MedicalDevice.",
      "rdfs:label": "uses device",
      "owl:inverseOf": {
        "@id": "edm:deviceUsed"
      }
    },
    {
      "@id": "edm:volume",
      "@type": "owl:DatatypeProperty",
      "schema:domainIncludes": {
        "@id": "edm:CreativeWork"
      },
      "rdfs:comment": "The volume of the CreativeWork associated with multi-volume CreativeWork such as BookSeries or Issue in Journals.",
      "rdfs:label": "volume",
      "rdfs:range": {
        "@id": "rdfs:Literal"
      }
    },
    {
      "@id": "edm:workPhoneNumber",
      "@type": "rdf:Property",
      "schema:domainIncludes": {
